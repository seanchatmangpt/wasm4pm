/// Static metadata for one cognition breed.
pub struct BreedInfo {
    pub id: &'static str,
    pub label: &'static str,
    pub doc: &'static str,
    pub citation: &'static str,
}

/// Every registered cognition breed, in stable (id-sorted) order.
pub const CATALOG: &[BreedInfo] = &[
{% for row in sparql_results %}    BreedInfo {
        id: "{{ row.breed_id }}",
        label: "{{ row.breed_label }}",
        doc: "{{ row.breed_doc | addslashes }}",
        citation: "{{ row.citation | addslashes }}",
    },
{% endfor %}];
