// Generated by ggen from ggen/ontology/phd-contracts.ttl.
// Source reachability is necessary but not sufficient for doctoral admission.

use std::path::{Path, PathBuf};

fn repository_root() -> PathBuf {
    Path::new(env!("CARGO_MANIFEST_DIR"))
        .join("../..")
        .canonicalize()
        .expect("repository root must be reachable from wasm4pm-cli")
}

fn assert_source_reachable(
    canonical_id: &str,
    implementation_symbol: &str,
    source_path: &str,
    bridge_path: Option<&str>,
) {
    let root = repository_root();
    let source = root.join(source_path);
    let body = std::fs::read_to_string(&source).unwrap_or_else(|error| {
        panic!(
            "{canonical_id}: source {} is not readable: {error}",
            source.display()
        )
    });
    let terminal_symbol = implementation_symbol
        .rsplit("::")
        .next()
        .unwrap_or(implementation_symbol);
    assert!(
        body.contains(terminal_symbol),
        "{canonical_id}: implementation symbol {implementation_symbol} is absent from {}",
        source.display()
    );

    if let Some(bridge_path) = bridge_path {
        let bridge = root.join(bridge_path);
        let metadata = std::fs::metadata(&bridge).unwrap_or_else(|error| {
            panic!(
                "{canonical_id}: declared bridge {} is not reachable: {error}",
                bridge.display()
            )
        });
        assert!(metadata.is_file(), "{} is not a file", bridge.display());
    }
}

{% for row in sparql_results %}#[test]
fn phd_mining_source_{{ loop.index }}() {
    assert_source_reachable(
        "{{ row.canonical_id }}",
        "{{ row.implementation_symbol }}",
        "{{ row.source_path }}",
        {% if row.bridge_path is defined %}Some("{{ row.bridge_path }}"){% else %}None{% endif %},
    );
}

