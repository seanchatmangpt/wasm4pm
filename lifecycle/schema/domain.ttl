    rdfs:comment "Swarm intelligence algorithm. Actually returns DFG, not Petri net (Phase 4 audit correction)." ;
    schema:resultType "dfg" ;
    schema:error <urn:uuid:failure-EmptyLogCase> ;
    schema:error <urn:uuid:failure-MalformedLogCase> ;
