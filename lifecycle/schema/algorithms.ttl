    rdfs:label "Streaming Log (Probabilistic)" ;
    rdfs:comment "Probabilistic streaming event log processor. Stateful handle-based API. Use streaming_log_create(), streaming_log_add_trace(), streaming_log_estimate_dfg(), streaming_log_free()." ;
    pm:outputType "analytics" ;
    pm:requiresNegativeCase pm:EmptyLogCase ;
    pm:requiresNegativeCase pm:MalformedLogCase ;
    pm:requiresInvariantCase pm:DeterministicSameInputCase .

