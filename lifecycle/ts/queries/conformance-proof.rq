PREFIX xes:  <https://wasm4pm.dev/xes#>
PREFIX lc:   <https://wasm4pm.dev/lifecycle#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

# CONSTRUCT a conformance report into the unrdf RDF store.
# Each observed edge is annotated as declared or undeclared.
#
# Pair with wasm4pm token-replay conformance for fitness/precision scoring.

CONSTRUCT {
    ?edgeNode a                  xes:ObservedEdge ;
              xes:fromActivity   ?from ;
              xes:toActivity     ?to ;
              xes:frequency      ?freq ;
              xes:conformant     ?conformant .
}
WHERE {
    # Count observed directly-follows pairs
    {
        SELECT ?from ?to (COUNT(*) AS ?freq) WHERE {
            ?e1 xes:activity  ?from ;
                xes:caseId    ?caseId ;
                xes:eventIndex ?i1 .
            ?e2 xes:activity  ?to ;
                xes:caseId    ?caseId ;
                xes:eventIndex ?i2 .
            FILTER(xsd:integer(?i2) = xsd:integer(?i1) + 1)
        }
        GROUP BY ?from ?to
    }

    BIND(IRI(CONCAT("https://wasm4pm.dev/xes#edge/", ?from, "/", ?to)) AS ?edgeNode)

    # Check if this edge is declared in the lifecycle ontology
    BIND(
        EXISTS {
            ?t a lc:Transition ;
               lc:fromStage ?fs ;
               lc:toStage   ?ts .
            ?fs rdfs:label ?from .
            ?ts rdfs:label ?to .
        } AS ?conformant
    )
}
