---
# Renders one real .github/workflows/FILENAME file per gha:Workflow
# individual, from typed gha:Job/gha:Step facts -- not an echoed literal.
# Self-contained sync.rs-native format (to:/sparql:/for_each:) -- this is
# the convention this marketplace's own qualify tooling expects of every
# pack template (see scripts/qualify_packs.py's FRONTMATTER_PROBE_TEMPLATE)
# and the convention every other real template in this repo already
# follows. A consumer wires this via a real `[[packs]]`/`[packs]` entry in
# their own ggen.toml (matching ggen-marketplace's own qualify consumer
# wiring), not `[[generation.rules]]`'s File-sourced workaround an earlier
# revision of this file used (that workaround existed only because
# [[generation.rules]]'s own `template = { pack = ... }` sourcing is
# separately broken in ggen 26.8.8, [FM-GEN-007] -- irrelevant to this
# self-contained path, which never touches TemplateSource::Pack at all).
#
# gha:Workflow individuals carrying gha:ownedBy must be excluded by the
# `workflows` query below (generation belongs elsewhere for those).
#
# for_each: workflows drives one output file per gha:Workflow row. The
# jobs:/steps: queries below return every job/step for every workflow
# (frontmatter sparql: values are static strings, not per-row templated,
# so no per-row filtering is possible here) -- the body filters both down
# to the current row's own wf/jobName using Tera's standard
# filter(attribute=, value=).
#
# GROUP_CONCAT separators use "%%GHA_SEP%%" for with/env, never a bare
# "|" -- real step values (e.g. `a || b || c` expressions) legitimately
# contain "|", so joining on that character corrupts them on split-back-
# apart (confirmed the hard way against a real diff, not assumed).
# Multi-line values (run: blocks, onBlock, jobExtra) are re-indented by
# looping split("\n") rather than the `indent` filter -- that filter's
# actual behavior didn't match assumption either, also confirmed against
# a real diff.
to: ".github/workflows/{{ fileName }}"
for_each: workflows
sparql:
  workflows: |
    PREFIX gha:  <http://seanchatmangpt.github.io/packs/github-actions#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?wf ?fileName ?purpose ?onBlock ?concurrencyPolicy ?permissionCeiling
           (GROUP_CONCAT(DISTINCT ?triggerLabel; separator=",") AS ?triggers)
           (GROUP_CONCAT(DISTINCT ?envKv; separator=",") AS ?workflowEnv)
    WHERE {
      ?wf a gha:Workflow ; gha:fileName ?fileName .
      FILTER NOT EXISTS { ?wf gha:ownedBy ?owner }
      OPTIONAL { ?wf gha:purpose ?purpose . }
      OPTIONAL { ?wf gha:onBlock ?onBlock . }
      OPTIONAL { ?wf gha:concurrencyPolicy ?concurrencyPolicy . }
      OPTIONAL { ?wf gha:permissionCeiling ?permissionCeiling . }
      OPTIONAL { ?wf gha:trigger ?t . ?t rdfs:label ?triggerLabel . }
      OPTIONAL { ?wf gha:workflowEnv ?envKv . }
    }
    GROUP BY ?wf ?fileName ?purpose ?onBlock ?concurrencyPolicy ?permissionCeiling
    ORDER BY ?fileName
  jobs: |
    PREFIX gha: <http://seanchatmangpt.github.io/packs/github-actions#>
    SELECT ?wf ?jobName ?runner ?timeoutMinutes ?condition ?jobPermissions ?jobExtra
           (GROUP_CONCAT(DISTINCT ?dep; separator=",") AS ?dependsOnList)
    WHERE {
      ?job a gha:Job ; gha:inWorkflow ?wf ; gha:jobName ?jobName .
      OPTIONAL { ?job gha:runner ?runner . }
      OPTIONAL { ?job gha:timeoutMinutes ?timeoutMinutes . }
      OPTIONAL { ?job gha:condition ?condition . }
      OPTIONAL { ?job gha:jobPermissions ?jobPermissions . }
      OPTIONAL { ?job gha:jobExtra ?jobExtra . }
      OPTIONAL { ?job gha:dependsOn ?depJob . ?depJob gha:jobName ?dep . }
    }
    GROUP BY ?wf ?jobName ?runner ?timeoutMinutes ?condition ?jobPermissions ?jobExtra
    ORDER BY ?wf ?jobName
  steps: |
    PREFIX gha: <http://seanchatmangpt.github.io/packs/github-actions#>
    SELECT ?wf ?jobName ?stepOrder ?stepName ?stepId ?usesAction ?runCommand ?condition ?continueOnError
           (GROUP_CONCAT(DISTINCT ?with; separator="%%GHA_SEP%%") AS ?withParams)
           (GROUP_CONCAT(DISTINCT ?env; separator="%%GHA_SEP%%") AS ?envVars)
    WHERE {
      ?step a gha:Step ; gha:inJob ?job ; gha:stepOrder ?stepOrder .
      ?job gha:jobName ?jobName ; gha:inWorkflow ?wf .
      OPTIONAL { ?step gha:stepName ?stepName . }
      OPTIONAL { ?step gha:stepId ?stepId . }
      OPTIONAL { ?step gha:usesAction ?usesAction . }
      OPTIONAL { ?step gha:runCommand ?runCommand . }
      OPTIONAL { ?step gha:condition ?condition . }
      OPTIONAL { ?step gha:continueOnError ?continueOnError . }
      OPTIONAL { ?step gha:withParam ?with . }
      OPTIONAL { ?step gha:envVar ?env . }
    }
    GROUP BY ?wf ?jobName ?stepOrder ?stepName ?stepId ?usesAction ?runCommand ?condition ?continueOnError
    ORDER BY ?wf ?jobName ?stepOrder
---
{%- macro reindent(text, spaces) -%}
{%- for line in text | split(pat="\n") -%}
{{ spaces }}{{ line }}
{% endfor -%}
{%- endmacro reindent -%}
name: {{ purpose | default(value=fileName) }}

{%- if onBlock %}
on:
{{ self::reindent(text=onBlock, spaces="  ") }}
{%- else %}
on:
{%- for t in triggers | split(pat=",") %}
  {{ t }}:
{%- endfor %}
{%- endif %}

{%- if concurrencyPolicy and concurrencyPolicy != "none" %}

concurrency:
{{ self::reindent(text=concurrencyPolicy, spaces="  ") }}
{%- endif %}

permissions:
  {{ permissionCeiling }}

{%- if workflowEnv %}

env:
{%- for kv in workflowEnv | split(pat=",") %}
  {{ kv }}
{%- endfor %}
{%- endif %}

jobs:
{%- set my_jobs = jobs | filter(attribute="wf", value=wf) %}
{%- for job in my_jobs %}
  {{ job.jobName }}:
    runs-on: {{ job.runner | default(value="ubuntu-latest") }}
{%- if job.timeoutMinutes %}
    timeout-minutes: {{ job.timeoutMinutes }}
{%- endif %}
{%- if job.dependsOnList %}
    needs: [{{ job.dependsOnList }}]
{%- endif %}
{%- if job.condition %}
    if: {{ job.condition }}
{%- endif %}
{%- if job.jobPermissions %}
    permissions:
{{ self::reindent(text=job.jobPermissions, spaces="      ") }}
{%- endif %}
{%- if job.jobExtra %}
{{ self::reindent(text=job.jobExtra, spaces="    ") }}
{%- endif %}
    steps:
{%- set my_steps = steps | filter(attribute="jobName", value=job.jobName) | filter(attribute="wf", value=wf) %}
{%- for step in my_steps %}
      - {% if step.stepName %}name: {{ step.stepName }}
        {% endif -%}
{%- if step.stepId %}id: {{ step.stepId }}
        {% endif -%}
{%- if step.condition %}if: {{ step.condition }}
        {% endif -%}
{%- if step.usesAction %}uses: {{ step.usesAction }}
        {% endif -%}
{%- if step.withParams %}with:
{%- for kv in step.withParams | split(pat="%%GHA_SEP%%") %}
          {{ kv }}
{%- endfor %}
        {% endif -%}
{%- if step.envVars %}env:
{%- for kv in step.envVars | split(pat="%%GHA_SEP%%") %}
          {{ kv }}
{%- endfor %}
        {% endif -%}
{%- if step.continueOnError %}continue-on-error: true
        {% endif -%}
{%- if step.runCommand %}run: |
{{ self::reindent(text=step.runCommand, spaces="          ") }}
{%- endif %}
{%- endfor %}
{%- endfor %}
