    rdfs:label "Integer Linear Programming (ILP)" ;
    rdfs:comment "Region-based Petri net discovery. Finds causal place candidates (1-to-1, AND-splits, AND-joins) validated by token replay, with greedy minimization. Produces precise Petri nets with explicit parallel-join/split structure." ;
    schema:resultType "petrinet" ;
    schema:error <urn:uuid:failure-EmptyLogCase> ;
    schema:error <urn:uuid:failure-MalformedLogCase> ;
    schema:target <urn:uuid:invariant-DeterministicSameInputCase> .

