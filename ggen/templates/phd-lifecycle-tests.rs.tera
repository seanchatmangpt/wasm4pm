// Generated by ggen from the admitted cognition ontology.
// Do not edit: change ggen/ontology/breeds.ttl or the doctoral templates.

use serde::de::DeserializeOwned;
use serde_json::Value;
use wasm4pm_cognition::breeds::{compute_receipt, dispatch_breed, BreedInput};

fn fixture_field<T>(input: &Value, key: &str, path: &str) -> T
where
    T: DeserializeOwned + Default,
{
    match input.get(key) {
        None => T::default(),
        Some(value) => serde_json::from_value(value.clone()).unwrap_or_else(|error| {
            panic!("FIXTURE {path} field input.{key} is invalid: {error}")
        }),
    }
}

fn load_fixture(breed_id: &str) -> BreedInput {
    let path = format!(
        "{}/tests/fixtures/papers/{breed_id}.json",
        env!("CARGO_MANIFEST_DIR")
    );
    let raw = std::fs::read_to_string(&path)
        .unwrap_or_else(|error| panic!("MISSING FIXTURE {path}: {error}"));
    let document: Value = serde_json::from_str(&raw)
        .unwrap_or_else(|error| panic!("UNPARSEABLE FIXTURE {path}: {error}"));
    let input = document
        .get("input")
        .unwrap_or_else(|| panic!("FIXTURE {path} has no input object"));

    BreedInput {
        intent: input
            .get("intent")
            .and_then(Value::as_str)
            .unwrap_or_default()
            .to_string(),
        candidates: fixture_field(input, "candidates", &path),
        facts: fixture_field(input, "facts", &path),
        cases: fixture_field(input, "cases", &path),
        rules: fixture_field(input, "rules", &path),
        goals: fixture_field(input, "goals", &path),
        state: fixture_field(input, "state", &path),
    }
}

fn canonicalize(value: Value) -> Value {
    match value {
        Value::Object(map) => {
            let mut entries: Vec<_> = map.into_iter().collect();
            entries.sort_by(|left, right| left.0.cmp(&right.0));
            Value::Object(
                entries
                    .into_iter()
                    .map(|(key, value)| (key, canonicalize(value)))
                    .collect(),
            )
        }
        Value::Array(values) => Value::Array(values.into_iter().map(canonicalize).collect()),
        scalar => scalar,
    }
}

fn assert_doctoral_lifecycle(breed_id: &str) {
    let input = load_fixture(breed_id);
    let first = dispatch_breed(breed_id, &input)
        .unwrap_or_else(|error| panic!("{breed_id} real fixture refused: {error}"));
    let second = dispatch_breed(breed_id, &input)
        .unwrap_or_else(|error| panic!("{breed_id} deterministic replay refused: {error}"));

    assert!(
        !first.inference_trace.is_empty(),
        "{breed_id}: empty inference trace is not doctoral evidence"
    );
    assert!(
        first.ocel_log.is_some(),
        "{breed_id}: full dispatch must attach OCEL evidence"
    );

    let first_value = canonicalize(serde_json::to_value(&first).expect("serialize first output"));
    let second_value = canonicalize(serde_json::to_value(&second).expect("serialize replay output"));
    assert_eq!(
        first_value, second_value,
        "{breed_id}: same admitted input produced different canonical output"
    );

    let receipt = compute_receipt(first.breed, &input, &first);
    for (name, hash) in [
        ("input_hash", receipt.input_hash.as_str()),
        ("output_hash", receipt.output_hash.as_str()),
        ("combined_hash", receipt.combined_hash.as_str()),
    ] {
        assert_eq!(hash.len(), 64, "{breed_id}: {name} is not a BLAKE3 hex digest");
        assert!(
            hash.chars().all(|character| character.is_ascii_hexdigit()),
            "{breed_id}: {name} contains non-hex characters"
        );
    }

    let empty = BreedInput::default();
    assert!(
        dispatch_breed(breed_id, &empty).is_err(),
        "{breed_id}: empty input must produce a typed refusal, not false success"
    );
}

{% for row in sparql_results %}#[test]
fn phd_lifecycle_{{ row.breed_id }}() {
    assert_doctoral_lifecycle("{{ row.breed_id }}");
}

{% endfor %}