\bibitem[Berry(1941)]{berry1941}
Andrew~C. Berry.
\newblock The accuracy of the {Gaussian} approximation to the sum of
  independent variates.
\newblock \emph{Transactions of the American Mathematical Society}, 49\penalty0
  (1):\penalty0 122--136, 1941.
\newblock \doi{10.2307/1990053}.
\newblock Establishes the rate $C/\sqrt{k}$ for the Kolmogorov--Smirnov
  distance between empirical and Gaussian distributions. Used in Theorem~8.1
  (Berry-Esseen bound for Bayesian sensitivity analysis).

\bibitem[Berti et~al.(2024)Berti, Koren, Adams, Park, et~al.]{ocel2standard}
Alessandro Berti, Isabelle Koren, Jan~Niklas Adams, Gyunam Park, et~al.
