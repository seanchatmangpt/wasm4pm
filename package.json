{
  "name": "wasm4pm-monorepo",
  "version": "26.5.19",
  "description": "High-performance process mining monorepo with WASM acceleration",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "wasm4pm",
    "apps/*",
    "packages/*",
    "playground",
    "lab"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "npx pnpm@9 -r build",
    "test": "npx pnpm@9 -r --parallel test",
    "test:coverage": "npx pnpm@9 -r --parallel --filter './packages/*' run test:coverage && cd wasm4pm && npm run test:coverage",
    "lint": "npx pnpm@9 -r lint",
    "clean": "npx pnpm@9 -r clean && rm -rf node_modules",
    "release:gauntlet": "bash scripts/release/prepublish-gauntlet.sh",
    "release:forbidden": "bash scripts/release/verify-forbidden-terms.sh",
    "examples:gate": "tsx scripts/examples/run-all.ts",
    "cli:parity": "tsx scripts/release/verify-cli-parity.ts",
    "prepublish:pack-smoke": "bash scripts/release/verify-pack-smoke.sh",
    "release:certificate": "tsx scripts/release/verify-release-certificate.ts",
    "release:doctor": "wpm doctor --release",
    "release:algorithm-behavior": "tsx scripts/release/algorithm-behavior/write-behavior-evidence.ts",
    "release:algorithm-reachability": "tsx scripts/release/algorithm-behavior/write-reachability-evidence.ts",
    "release:verify-algorithm-behavior": "tsx scripts/release/verify-algorithm-behavior.ts",
    "release:full": "npm run release:forbidden && npm run release:algorithm-reachability && npm run release:algorithm-behavior && npm run release:verify-algorithm-behavior && npm run examples:gate && npm run prepublish:pack-smoke && npm run release:certificate && tsx scripts/release/verify-certificate-authenticity.ts",
    "build:wasm": "npx pnpm@9 --filter @wasm4pm/core build:all",
    "build:engine": "npx pnpm@9 --filter @wasm4pm/engine build",
    "build:cli": "npx pnpm@9 --filter @wasm4pm/cli build",
    "build:all": "npm run build:wasm && npm run build:engine && npm run build:cli",
    "dev": "npm run build:engine && npm run build:cli",
    "ci:test": "npx pnpm@9 run tps:check && npx pnpm@9 run lint && npx pnpm@9 run test",
    "ci:build": "npx pnpm@9 run build:all",
    "generate": "unrdf sync --config unrdf.toml",
    "generate:algorithms": "unrdf sync --config unrdf.toml --rule algorithm-registry && npx pnpm@9 --filter @wasm4pm/templates build",
    "generate:prediction-tasks": "unrdf sync --config unrdf.toml --rule prediction-tasks && npx pnpm@9 --filter @wasm4pm/templates build",
    "format": "prettier --write 'packages/*/src/**/*.ts' 'apps/*/src/**/*.ts' 'packages/*/src/**/*.json'",
    "format:check": "prettier --check 'packages/*/src/**/*.ts' 'apps/*/src/**/*.ts' 'packages/*/src/**/*.json'",
    "health": "node scripts/health.mjs",
    "tps:check": "node scripts/tps-pipeline-check.mjs",
    "tps:check:json": "node scripts/tps-pipeline-check.mjs --json",
    "docs:lint": "markdownlint '**/*.md' --config .markdownlint.json --ignore node_modules --ignore docs_quarantine --ignore docs/archive",
    "docs:link-check": "find . -name '*.md' -not -path '*/node_modules/*' -not -path '*/docs_quarantine/*' -not -path '*/docs/archive/*' -print0 | xargs -0 npx markdown-link-check --config .mlc.config.json",
    "docs:check": "npx pnpm@9 run docs:lint && npx pnpm@9 run docs:link-check",
    "postinstall": "node scripts/check-engines.mjs",
    "build:browser": "bash scripts/build-profile.sh browser",
    "build:edge": "bash scripts/build-profile.sh edge",
    "build:fog": "bash scripts/build-profile.sh fog",
    "build:iot": "bash scripts/build-profile.sh iot",
    "build:cloud": "bash scripts/build-profile.sh cloud",
    "build:profiles": "bash scripts/build-all-profiles.sh",
    "verify:profiles": "node scripts/verify-profiles.js",
    "bench:real": "node benchmarks/real_data_wasm_bench.js"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.0",
    "typescript": "^5.3.3",
    "prettier": "^3.1.1"
  }
}
