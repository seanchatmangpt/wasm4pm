{
  "name": "@wasm4pm/swarm",
  "version": "26.4.17",
  "description": "Autonomic swarm coordinator for wasm4pm — multi-worker process mining with convergence detection",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "wasm4pm-swarm": "./dist/mcp-server.js"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@ai-sdk/groq": "^3.0.35",
    "@modelcontextprotocol/sdk": "^1.10.2",
    "@wasm4pm/contracts": "workspace:*",
    "@wasm4pm/kernel": "workspace:*",
    "@wasm4pm/observability": "workspace:*",
    "ai": "^6.0.168",
    "uuid": "^9.0.1",
    "wasm4pm": "workspace:^",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.7",
    "@vitest/coverage-v8": "^1.6.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
