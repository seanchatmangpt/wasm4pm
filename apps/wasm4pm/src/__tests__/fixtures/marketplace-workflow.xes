<?xml version="1.0" encoding="UTF-8"?>
<log xes.version="1.0" xes.features="nested-attributes" xmlns="http://www.xes-standard.org/">
  <extension name="Concept" prefix="concept" uri="http://www.xes-standard.org/concept.xesext"/>
  <extension name="Time" prefix="time" uri="http://www.xes-standard.org/time.xesext"/>
  <extension name="Organizational" prefix="org" uri="http://www.xes-standard.org/org.xesext"/>

  <!-- Case 1: Complete happy-path purchase workflow -->
  <trace>
    <string key="concept:name" value="order-001"/>
    <event>
      <string key="concept:name" value="place_order"/>
      <date key="time:timestamp" value="2026-05-01T09:00:00.000Z"/>
      <string key="org:resource" value="customer"/>
    </event>
    <event>
      <string key="concept:name" value="validate_payment"/>
      <date key="time:timestamp" value="2026-05-01T09:05:00.000Z"/>
      <string key="org:resource" value="payment-service"/>
    </event>
    <event>
      <string key="concept:name" value="fulfill_order"/>
      <date key="time:timestamp" value="2026-05-01T09:30:00.000Z"/>
      <string key="org:resource" value="warehouse"/>
    </event>
    <event>
      <string key="concept:name" value="ship_order"/>
      <date key="time:timestamp" value="2026-05-01T10:00:00.000Z"/>
      <string key="org:resource" value="logistics"/>
    </event>
    <event>
      <string key="concept:name" value="deliver_order"/>
      <date key="time:timestamp" value="2026-05-03T14:00:00.000Z"/>
      <string key="org:resource" value="logistics"/>
    </event>
  </trace>

  <!-- Case 2: Complete happy-path purchase workflow -->
