{
  "name": "@wasm4pm/supabase",
  "version": "26.7.23",
  "publishConfig": {
    "access": "public"
  },
  "description": "Supabase integration for wasm4pm receipts, TrueX envelopes, and offline sync",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "@wasm4pm/contracts": "workspace:*",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "keywords": [
    "supabase",
    "receipts",
    "truex",
    "process-mining"
  ],
  "license": "SEE LICENSE IN LICENSE"
}
