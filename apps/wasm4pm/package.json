{
  "name": "@wasm4pm/cli",
  "version": "26.6.25",
  "description": "wasm4pm \u2014 High-performance WASM-powered process mining CLI",
  "type": "module",
  "bin": {
    "wpm": "./dist/bin/wpm.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@wasm4pm/agents": "workspace:*",
    "@wasm4pm/cognition": "workspace:*",
    "@wasm4pm/config": "workspace:*",
    "@wasm4pm/contracts": "workspace:*",
    "@wasm4pm/engine": "workspace:*",
    "wasm4pm": "workspace:*",
    "@wasm4pm/ml": "workspace:*",
    "@wasm4pm/observability": "workspace:*",
    "@wasm4pm/planner": "workspace:*",
    "@wasm4pm/supabase": "workspace:*",
    "ajv": "^8.12.0",
    "chokidar": "^4.0.1",
    "citty": "^0.1.6",
    "consola": "^3.2.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@types/node": "^20.10.0",
    "@wasm4pm/testing": "workspace:*",
    "typescript": "^5.3.3",
    "vite-plugin-wasm": "^3.3.0",
    "vitest": "^1.1.0"
  },
  "keywords": [
    "process-mining",
    "cli",
    "discovery",
    "workflow"
  ],
  "author": "Sean Chatman",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/seanchatmangpt/wasm4pm.git",
    "directory": "apps/wasm4pm"
  },
  "homepage": "https://github.com/seanchatmangpt/wasm4pm#readme",
  "bugs": {
    "url": "https://github.com/seanchatmangpt/wasm4pm/issues"
  }
}
