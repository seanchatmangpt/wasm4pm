  "output": {
    "format": "human",
    "destination": "stdout",
    "pretty": true,
    "colorize": true
  },
  "prediction": {
    "enabled": false,
    "activityKey": "concept:name",
    "ngramOrder": 2,
    "driftWindowSize": 10,
    "tasks": []
  }
}