# Driving query for the "ci-workflows-render" generation rule.
#
# One row per gha:Workflow NOT carrying gha:ownedBy (workflows owned by
# another pack carry no body facts and are excluded from rendering, same
# convention as the pack's own templates/workflow.yml.tmpl doc comment).
# Uses a flat GROUP BY over every non-aggregated column (matching the
# proven-working pattern already inside workflow.yml.tmpl's own inline
# jobs_q/steps_q queries) instead of a nested SELECT, since that is the
# form already verified to execute against this engine.
#
# workflowEnv / triggers are GROUP_CONCAT'd with a plain "," separator to
# match workflow.yml.tmpl's top-level `| split(pat=",")` calls -- NOT the
# "%%GHA_SEP%%" separator, which is reserved for the template's own nested
# per-job/per-step with:/env: queries.
PREFIX gha:  <http://seanchatmangpt.github.io/packs/github-actions#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?wf ?fileName ?purpose ?onBlock ?concurrencyPolicy ?permissionCeiling
       (GROUP_CONCAT(DISTINCT ?env; separator=",") AS ?workflowEnv)
       (GROUP_CONCAT(DISTINCT ?tlabel; separator=",") AS ?triggers)
WHERE {
  ?wf a gha:Workflow ;
      gha:fileName ?fileName .
  FILTER NOT EXISTS { ?wf gha:ownedBy ?owner }
  OPTIONAL { ?wf gha:purpose ?purpose }
  OPTIONAL { ?wf gha:onBlock ?onBlock }
  OPTIONAL { ?wf gha:concurrencyPolicy ?concurrencyPolicy }
  OPTIONAL { ?wf gha:permissionCeiling ?permissionCeiling }
  OPTIONAL { ?wf gha:workflowEnv ?env }
  OPTIONAL { ?wf gha:trigger ?t . ?t rdfs:label ?tlabel }
}
GROUP BY ?wf ?fileName ?purpose ?onBlock ?concurrencyPolicy ?permissionCeiling
ORDER BY ?fileName
