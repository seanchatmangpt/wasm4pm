{
  "name": "@wasm4pm/autopm",
  "version": "26.6.10",
  "publishConfig": {
    "access": "public"
  },
  "description": "Deterministic evolutionary AutoPM engine for wasm4pm (NSGA-II over pipeline genomes)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@wasm4pm/config": "workspace:*",
    "@wasm4pm/contracts": "workspace:*",
    "@wasm4pm/planner": "workspace:*",
    "toml": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^1.6.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "keywords": [
    "process-mining",
    "automl",
    "nsga-ii",
    "evolutionary",
    "deterministic"
  ],
  "author": "Sean Chatman",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/seanchatmangpt/wasm4pm.git",
    "directory": "packages/autopm"
  },
  "homepage": "https://github.com/seanchatmangpt/wasm4pm#readme",
  "bugs": {
    "url": "https://github.com/seanchatmangpt/wasm4pm/issues"
  }
}
