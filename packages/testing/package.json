{
  "name": "@wasm4pm/testing",
  "version": "26.6.8",
  "publishConfig": {
    "access": "public"
  },
  "description": "Testing utilities and fixtures",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./harness/cli": {
      "import": "./dist/harness/cli.js",
      "types": "./dist/harness/cli.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@wasm4pm/contracts": "26.6.8"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^1.6.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "keywords": [
    "testing",
    "fixtures",
    "utilities"
  ],
  "author": "Sean Chatman",
  "license": "SEE LICENSE IN LICENSE"
}
