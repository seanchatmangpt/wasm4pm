// Generated by ggen from phd:CliCase instances.
// Each command executes twice in isolated directories and must emit receipt + span evidence.

use serde_json::Value;
use std::ffi::OsString;
use std::path::{Path, PathBuf};
use std::process::Command;

fn repository_root() -> PathBuf {
    Path::new(env!("CARGO_MANIFEST_DIR"))
        .join("../..")
        .canonicalize()
        .expect("repository root must be reachable")
}

fn resolved_argument(root: &Path, argument: &str) -> OsString {
    if argument.starts_with("crates/") || argument.starts_with("wasm4pm/") {
        root.join(argument).into_os_string()
    } else {
        OsString::from(argument)
    }
}

#[derive(Debug)]
struct RunEvidence {
    stdout: Vec<u8>,
    receipt: Value,
    span: Value,
}

fn execute(arguments: &str) -> RunEvidence {
    let root = repository_root();
    let working = tempfile::tempdir().expect("isolated CLI working directory");
    let resolved: Vec<OsString> = arguments
        .split_ascii_whitespace()
        .map(|argument| resolved_argument(&root, argument))
        .collect();

    let output = Command::new(env!("CARGO_BIN_EXE_wpm"))
        .args(&resolved)
        .current_dir(working.path())
        .env("NO_COLOR", "1")
        .output()
        .expect("execute wpm");

    assert!(
        output.status.success(),
        "wpm {:?} failed\nstdout:\n{}\nstderr:\n{}",
        resolved,
        String::from_utf8_lossy(&output.stdout),
        String::from_utf8_lossy(&output.stderr)
    );

    let receipt_path = working.path().join(".wasm4pm/receipts/latest.json");
    let span_path = working.path().join(".wasm4pm/otel/latest.json");
    let receipt: Value = serde_json::from_slice(
        &std::fs::read(&receipt_path)
            .unwrap_or_else(|error| panic!("missing receipt {}: {error}", receipt_path.display())),
    )
    .expect("receipt JSON");
    let span: Value = serde_json::from_slice(
        &std::fs::read(&span_path)
            .unwrap_or_else(|error| panic!("missing span {}: {error}", span_path.display())),
    )
    .expect("span JSON");

    RunEvidence {
        stdout: output.stdout,
        receipt,
        span,
    }
}

fn assert_case(arguments: &str, operation: &str, expected_token: &str) {
    let first = execute(arguments);
    let second = execute(arguments);

    let stdout = String::from_utf8(first.stdout.clone()).expect("CLI stdout is UTF-8");
    assert!(
        stdout.contains(expected_token),
        "operation {operation} did not emit expected token {expected_token:?}; stdout={stdout}"
    );
    assert_eq!(
        first.stdout, second.stdout,
        "operation {operation} is not deterministic under identical admitted input"
    );

    for (ordinal, evidence) in [("first", first), ("second", second)] {
        assert_eq!(
            evidence.receipt["service_name"].as_str(),
            Some("wasm4pm-cli"),
            "{operation} {ordinal} receipt service_name"
        );
        assert_eq!(
            evidence.receipt["operation"].as_str(),
            Some(operation),
            "{operation} {ordinal} receipt operation"
        );
        assert_eq!(
            evidence.receipt["status"].as_str(),
            Some("ok"),
            "{operation} {ordinal} receipt status"
        );
        for field in ["input_hash", "output_hash", "receipt_hash"] {
            let hash = evidence.receipt[field]
                .as_str()
                .unwrap_or_else(|| panic!("{operation} {ordinal} receipt missing {field}"));
            assert_eq!(hash.len(), 64, "{operation} {ordinal} {field} length");
            assert!(hash.chars().all(|character| character.is_ascii_hexdigit()));
        }

        assert_eq!(
            evidence.span["service_name"].as_str(),
            Some("wasm4pm-cli"),
            "{operation} {ordinal} span service_name"
        );
        assert_eq!(
            evidence.span["name"].as_str(),
            Some(operation),
            "{operation} {ordinal} span name"
        );
        assert_eq!(
            evidence.span["status"].as_str(),
            Some("ok"),
            "{operation} {ordinal} span status"
        );
    }
}

{% for row in sparql_results %}#[test]
fn phd_cli_{{ row.case_id }}() {
    assert_case(
        r#"{{ row.arguments }}"#,
        "{{ row.operation_name }}",
        r#"{{ row.expected_token }}"#,
    );
}

{% endfor %}