#[derive(Debug, Clone)]
pub struct EvidenceEnvelope {
    pub service_name: &'static str,
    pub operation: String,
    pub status: String,
    pub input_hash: String,
    pub output_hash: String,
    pub receipt_hash: String,
    pub receipt_path: PathBuf,
    pub span_path: PathBuf,
}

fn atomic_write(path: &Path, bytes: &[u8]) -> Result<()> {
    let parent = path
        .parent()
        .context("evidence path must have a parent directory")?;
    std::fs::create_dir_all(parent)
        .with_context(|| format!("create evidence directory {}", parent.display()))?;
    let temporary = path.with_extension("tmp");
    std::fs::write(&temporary, bytes)
        .with_context(|| format!("write temporary evidence {}", temporary.display()))?;
    if path.exists() {
        std::fs::remove_file(path)
            .with_context(|| format!("replace existing evidence {}", path.display()))?;
    }
    std::fs::rename(&temporary, path)
        .with_context(|| format!("commit evidence {}", path.display()))?;
    Ok(())
}

pub fn emit_evidence(
    operation: &str,
    input_bytes: &[u8],
    output_bytes: &[u8],
    status: &str,
) -> Result<EvidenceEnvelope> {
    if !matches!(status, "ok" | "error") {
        bail!("OTEL_STATUS_REFUSED: status must be 'ok' or 'error'");
    }
    if operation.trim().is_empty() {
        bail!("OPERATION_NAME_REFUSED: operation must be non-empty");
    }

    let receipt_path = PathBuf::from(RECEIPT_PATH);
    let span_path = PathBuf::from(SPAN_PATH);
    let input_hash = blake3::hash(input_bytes).to_hex().to_string();
    let output_hash = blake3::hash(output_bytes).to_hex().to_string();
    let previous_receipt_hash = std::fs::read(&receipt_path)
        .ok()
        .map(|bytes| blake3::hash(&bytes).to_hex().to_string());

    let receipt_core = json!({
        "schema": "wasm4pm.operation-receipt.v1",
        "service_name": SERVICE_NAME,
        "operation": operation,
        "status": status,
        "input_hash": input_hash,
        "output_hash": output_hash,
        "previous_receipt_hash": previous_receipt_hash,
    });
    let receipt_core_bytes = serde_json::to_vec(&receipt_core)?;
    let receipt_hash = blake3::hash(&receipt_core_bytes).to_hex().to_string();
    let receipt = json!({
        "schema": "wasm4pm.operation-receipt.v1",
        "service_name": SERVICE_NAME,
        "operation": operation,
        "status": status,
        "input_hash": input_hash,
        "output_hash": output_hash,
        "previous_receipt_hash": previous_receipt_hash,
        "receipt_hash": receipt_hash,
    });
    atomic_write(&receipt_path, &serde_json::to_vec_pretty(&receipt)?)?;

    let trace_id = &receipt_hash[..32];
    let span_id = &receipt_hash[..16];
    let span = json!({
        "schema": "wasm4pm.otel-span.v1",
        "trace_id": trace_id,
        "span_id": span_id,
        "service_name": SERVICE_NAME,
        "name": operation,
        "status": status,
        "attributes": {
            "input_hash": input_hash,
            "output_hash": output_hash,
            "receipt_hash": receipt_hash,
        }
    });
    atomic_write(&span_path, &serde_json::to_vec_pretty(&span)?)?;

    Ok(EvidenceEnvelope {
        service_name: SERVICE_NAME,
        operation: operation.to_string(),
        status: status.to_string(),
        input_hash,
        output_hash,
        receipt_hash,
        receipt_path,
        span_path,
    })
}
