\newblock arXiv:2506.11541. Formal Definitions~1--9 for OCPQ query tree
  semantics over object-centric event logs.

\bibitem[Laird et~al.(1987)Laird, Newell, and Rosenbloom]{laird1987soar}
John~E. Laird, Allen Newell, and Paul~S. Rosenbloom.
\newblock {SOAR}: An architecture for general intelligence.
\newblock \emph{Artificial Intelligence}, 33\penalty0 (1):\penalty0 1--64,
