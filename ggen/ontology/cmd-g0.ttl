cmd:G3_verification a cmd:Dimension ; cmd:checkpoint cmd:G3 ; cmd:dimensionId "verification" ; cmd:scope "internal" ; cmd:selectionCardinality "one-or-more" ; cmd:riskClass "CRITICAL" ; cmd:coverageMode "risk-exhaustive" ; cmd:resourceCeiling 256 .
