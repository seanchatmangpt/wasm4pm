{
  "name": "@wasm4pm/playground",
  "version": "26.6.25",
  "description": "Local dev behavior simulation — tests local source using real harnesses",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitest",
    "test": "vitest run",
    "run": "vitest run",
    "run:verbose": "vitest run --reporter=verbose",
    "scenario": "vitest run --reporter=verbose -t",
    "clean": "rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "dependencies": {
    "@wasm4pm/config": "workspace:*",
    "@wasm4pm/contracts": "workspace:*",
    "@wasm4pm/engine": "workspace:*",
    "wasm4pm": "workspace:*",
    "@wasm4pm/observability": "workspace:*",
    "@wasm4pm/planner": "workspace:*",
    "@wasm4pm/testing": "workspace:*"
  }
}
