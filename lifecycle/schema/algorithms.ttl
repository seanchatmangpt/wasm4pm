    pm:outputType "dfg" ;
    pm:requiresNegativeCase pm:EmptyLogCase ;
    pm:requiresNegativeCase pm:MalformedLogCase ;
    pm:requiresInvariantCase pm:DeterministicSameInputCase .

wpm:algo_hill_climbing a pm:DiscoveryAlgorithm ;
