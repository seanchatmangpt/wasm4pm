# Compiled TypeScript output (tsc --outDir is not set; files land next to sources)
*.js
*.mjs
*.cjs
*.d.ts
*.d.mts
*.d.cts
*.js.map
*.mjs.map
*.d.ts.map
*.d.mts.map

# web-dashboard is a plain-JS Vite example (no tsc build step) — its .js files
# are hand-written source, not compiled output, so they must not be caught
# by the *.js rule above.
!web-dashboard/src/*.js

# Runtime output directory
out/

# Dependencies
node_modules/
