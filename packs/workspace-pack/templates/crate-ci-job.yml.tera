{#- One row per compat:WorkspaceCrate -> one job fragment. crateDir may
    contain "/" (e.g. "crates/wasm4pm-cli"); the job id below replaces "/"
    with "-" so it's a valid YAML/GHA job key. This is a FRAGMENT (jobs:
    body indented for splicing under an existing `jobs:` key in a real
    workflow — e.g. via .specify/ci-workflows.ttl's gha:Job facts, or by
    hand-pasting), not a runnable standalone workflow file — it has no
    `on:`/`name:` top level, matching github-actions-pack's gha:Job layer
    so this pack composes with that pack rather than duplicating it. #}
{%- set job_id = crateDir | replace(from="/", to="-") -%}
  {{ job_id }}-checks:
    name: "{{ packageName }} — fmt, clippy, test"
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: {{ crateDir }}
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt, clippy
      - name: fmt check
        run: cargo fmt --check
      - name: clippy
        run: cargo clippy --all-targets -- -D warnings
{%- if hasTests == "true" %}
      - name: test
        run: cargo test --all-features
{%- endif %}
{%- if hasWasmBindgen == "true" %}
      - name: wasm32 build check
        run: |
          rustup target add wasm32-unknown-unknown
          cargo build --target wasm32-unknown-unknown
{%- endif %}
