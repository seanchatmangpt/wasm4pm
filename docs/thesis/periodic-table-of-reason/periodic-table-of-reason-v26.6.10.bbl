\bibitem[Feller(1968)]{feller1968}
William Feller.
\newblock \emph{An Introduction to Probability Theory and Its Applications},
  volume~2.
\newblock Wiley, New York, 2nd edition, 1968.
\newblock Standard graduate probability reference. Contains the Berry-Esseen
  theorem in the form used in Theorem~8.1, establishing the phase-transition
  latency bound $\tau^*_\varepsilon$.

\bibitem[Fikes and Nilsson(1971)]{fikes1971strips}
Richard~E. Fikes and Nils~J. Nilsson.
