    schema:resultType "dfg" ;
    schema:error <urn:uuid:failure-EmptyLogCase> ;
    schema:error <urn:uuid:failure-MalformedLogCase> ;
    schema:target <urn:uuid:invariant-SeededRepeatabilityCase> .

wpm:algo_declare a mls:Algorithm ;
    rdfs:label "Declare (Constraints)" ;
    rdfs:comment "Discovers declarative (constraint-based) process models. Good for flexible processes." ;
    schema:resultType "declare" ;
    schema:error <urn:uuid:failure-EmptyLogCase> ;
