@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix compat: <https://wasm4pm.dev/ns#> .
@prefix phd:    <https://wasm4pm.dev/phd#> .

# This graph declares obligations, never successful evidence.  A implementation
# may enter ALIVE only through measured evidence joined by the admission rules.

phd:MiningImplementation a rdf:Class .
phd:ImplementationProfile a rdf:Class .
phd:EvidenceKind a rdf:Class .

phd:canonicalId a rdf:Property ; phd:requiredOnMining true .
phd:implementationSymbol a rdf:Property ; phd:requiredOnMining true .
phd:sourcePath a rdf:Property ; phd:requiredOnMining true .
phd:determinismClass a rdf:Property ; phd:requiredOnMining true .
phd:methodClass a rdf:Property ; phd:requiredOnMining true .
phd:domain a rdf:Property ; phd:requiredOnMining true .
phd:evidenceProfile a rdf:Property ; phd:requiredOnMining true .
phd:admissionState a rdf:Property ; phd:requiredOnMining true .
phd:bridgePath a rdf:Property .
phd:appliesToClass a rdf:Property .
phd:requiresEvidence a rdf:Property .
phd:requiredOnMining a rdf:Property .
phd:evidenceFor a rdf:Property .
phd:evidenceKind a rdf:Property .
phd:observedAtCommit a rdf:Property .
phd:verified a rdf:Property .

phd:NativeBuild a phd:EvidenceKind .
phd:WasmBuild a phd:EvidenceKind .
phd:DedicatedTest a phd:EvidenceKind .
phd:RealInputRun a phd:EvidenceKind .
phd:PaperOracle a phd:EvidenceKind .
phd:NegativeFixture a phd:EvidenceKind .
phd:InvariantFixture a phd:EvidenceKind .
phd:DeterminismReplay a phd:EvidenceKind .
phd:AntiCheat a phd:EvidenceKind .
phd:Blake3Receipt a phd:EvidenceKind .
phd:OtelSpan a phd:EvidenceKind .
phd:IndependentReplay a phd:EvidenceKind .

phd:DoctoralAlgorithmProfile a phd:ImplementationProfile ;
  phd:requiresEvidence phd:NativeBuild,
    phd:WasmBuild,
    phd:DedicatedTest,
    phd:RealInputRun,
    phd:PaperOracle,
    phd:NegativeFixture,
    phd:InvariantFixture,
    phd:DeterminismReplay,
    phd:AntiCheat,
    phd:Blake3Receipt,
    phd:OtelSpan,
    phd:IndependentReplay .

phd:DoctoralCognitionProfile a phd:ImplementationProfile ;
  phd:appliesToClass compat:CognitionBreed ;
  phd:requiresEvidence phd:NativeBuild,
    phd:WasmBuild,
    phd:DedicatedTest,
    phd:RealInputRun,
    phd:PaperOracle,
    phd:NegativeFixture,
    phd:InvariantFixture,
    phd:DeterminismReplay,
    phd:AntiCheat,
    phd:Blake3Receipt,
    phd:OtelSpan,
    phd:IndependentReplay .

# Canonical process-mining census.  IDs, symbols, and classifications are data;
# algorithm bodies remain handwritten mathematical kernels.

phd:Algorithm_dfg a phd:MiningImplementation ;
  phd:canonicalId "dfg" ;
  phd:implementationSymbol "discover_dfg_from_log" ;
  phd:sourcePath "wasm4pm/src/discovery.rs" ;
  phd:determinismClass "deterministic" ;
  phd:methodClass "exact" ;
  phd:domain "directly-follows graph" ;
  phd:evidenceProfile phd:DoctoralAlgorithmProfile ;
  phd:admissionState "UNVERIFIED" .

