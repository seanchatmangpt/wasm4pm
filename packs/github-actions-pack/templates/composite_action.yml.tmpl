---
# Renders one .github/actions/ACTIONDIRNAME/action.yml per gha:CompositeAction
# individual, from typed gha:Step facts. Self-contained sync.rs-native format
# (to:/sparql:/for_each:) -- this is the convention this marketplace's own
# qualify tooling expects of every pack template (see
# scripts/qualify_packs.py's FRONTMATTER_PROBE_TEMPLATE), and the convention
# every other real template in this repo (cargo-cicd-pack, ggen-release-pack,
# ggen-constitution-pack, etc.) already follows -- not the
# [[generation.rules]] File-sourced workaround workflow.yml.tmpl currently
# uses (that workaround exists only because [[generation.rules]]'s own
# `template = { pack = ... }` sourcing is separately broken in ggen 26.8.8,
# [FM-GEN-007] -- File/File sourcing was the fix there, not a reason to skip
# frontmatter here too). A consumer wires this via a real `[[packs]]`/`[packs]`
# entry in their own ggen.toml (matching ggen-marketplace's own qualify
# consumer wiring), not `[[generation.rules]]`.
#
# for_each: actions drives one output file per gha:CompositeAction row. The
# steps: query below returns EVERY step for EVERY action (frontmatter sparql:
# values are static strings, not per-row templated, so no per-row filtering
# is possible here) -- the body filters steps down to the current row's own
# actionDirName using Tera's standard filter(attribute=, value=).
#
# GROUP_CONCAT separators use "%%GHA_SEP%%", never a bare "|" -- real content
# can legitimately contain "|". Multi-line values are re-indented by looping
# split("\n") rather than the `indent` filter (see workflow.yml.tmpl's header
# for why that filter's actual behavior didn't match assumption, confirmed
# against a real diff, not guessed).
to: ".github/actions/{{ actionDirName }}/action.yml"
for_each: actions
sparql:
  actions: |
    PREFIX gha: <http://seanchatmangpt.github.io/packs/github-actions#>
    SELECT ?actionDirName ?actionPurpose
           (GROUP_CONCAT(DISTINCT ?in; separator="%%GHA_SEP%%") AS ?inputs)
           (GROUP_CONCAT(DISTINCT ?indef; separator="%%GHA_SEP%%") AS ?inputDefaults)
           (GROUP_CONCAT(DISTINCT ?out; separator="%%GHA_SEP%%") AS ?outputs)
    WHERE {
      ?action a gha:CompositeAction ; gha:actionDirName ?actionDirName .
      OPTIONAL { ?action gha:actionPurpose ?actionPurpose . }
      OPTIONAL { ?action gha:actionInput ?in . }
      OPTIONAL { ?action gha:actionInputDefault ?indef . }
      OPTIONAL { ?action gha:actionOutput ?out . }
    }
    GROUP BY ?actionDirName ?actionPurpose
    ORDER BY ?actionDirName
  steps: |
    PREFIX gha: <http://seanchatmangpt.github.io/packs/github-actions#>
    SELECT ?actionDirName ?stepOrder ?stepName ?stepId ?usesAction ?runCommand ?condition
           (GROUP_CONCAT(DISTINCT ?with; separator="%%GHA_SEP%%") AS ?withParams)
           (GROUP_CONCAT(DISTINCT ?env; separator="%%GHA_SEP%%") AS ?envVars)
    WHERE {
      ?step a gha:Step ; gha:inJob ?action ; gha:stepOrder ?stepOrder .
      ?action gha:actionDirName ?actionDirName .
      OPTIONAL { ?step gha:stepName ?stepName . }
      OPTIONAL { ?step gha:stepId ?stepId . }
      OPTIONAL { ?step gha:usesAction ?usesAction . }
      OPTIONAL { ?step gha:runCommand ?runCommand . }
      OPTIONAL { ?step gha:condition ?condition . }
      OPTIONAL { ?step gha:withParam ?with . }
      OPTIONAL { ?step gha:envVar ?env . }
    }
    GROUP BY ?actionDirName ?stepOrder ?stepName ?stepId ?usesAction ?runCommand ?condition
    ORDER BY ?actionDirName ?stepOrder
---
{%- macro reindent(text, spaces) -%}
{%- for line in text | split(pat="\n") -%}
{{ spaces }}{{ line }}
{% endfor -%}
{%- endmacro reindent -%}
name: {{ actionPurpose | default(value=actionDirName) }}
description: {{ actionPurpose | default(value=actionDirName) }}

{%- if inputs %}
inputs:
{%- for kv in inputs | split(pat="%%GHA_SEP%%") %}
{%- set input_name = kv | split(pat=":") | first | trim %}
  {{ input_name }}:
    description: {{ kv | split(pat=":", n=2) | last | trim }}
    required: false
{%- if inputDefaults %}
{%- set input_prefix = input_name ~ ":" %}
{%- for dv in inputDefaults | split(pat="%%GHA_SEP%%") %}
{%- if dv is starting_with(input_prefix) %}
    default: {{ dv | split(pat=":", n=2) | last | trim }}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endif %}

{%- if outputs %}
outputs:
{%- for kv in outputs | split(pat="%%GHA_SEP%%") %}
  {{ kv | split(pat=":") | first | trim }}:
    description: {{ kv | split(pat=":", n=2) | last | trim }}
{%- endfor %}
{%- endif %}

runs:
  using: composite
  steps:
{%- set my_steps = steps | filter(attribute="actionDirName", value=actionDirName) %}
{%- for step in my_steps %}
    - {% if step.stepName %}name: {{ step.stepName }}
      {% endif -%}
{%- if step.stepId %}id: {{ step.stepId }}
      {% endif -%}
{%- if step.condition %}if: {{ step.condition }}
      {% endif -%}
{%- if step.usesAction %}uses: {{ step.usesAction }}
      {% endif -%}
{%- if step.withParams %}with:
{%- for kv in step.withParams | split(pat="%%GHA_SEP%%") %}
        {{ kv }}
{%- endfor %}
      {% endif -%}
{%- if step.envVars %}env:
{%- for kv in step.envVars | split(pat="%%GHA_SEP%%") %}
        {{ kv }}
{%- endfor %}
      {% endif -%}
{%- if step.runCommand %}shell: bash
      run: |
{{ self::reindent(text=step.runCommand, spaces="        ") }}
{%- endif %}
{%- endfor %}
