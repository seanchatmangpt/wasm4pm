# Rust
# Unanchored: matches workspace member target/ dirs at any depth.
target/
**/*.rs.bk

# WASM build artifacts
*.wasm
wasm4pm/pkg/

# Node
node_modules/
.pnpm-store/
# pnpm-lock.yaml is committed for reproducible workspace installs.
# package-lock.json is blocked by .github/workflows/repo-hygiene.yml, not by ignore.
package-lock.json
yarn.lock

# TypeScript build
dist/
*.tsbuildinfo
**/node_modules/.vite/

# Test & coverage
coverage/
.nyc_output/

# wasm4pm runtime
.wasm4pm/
.wasm4pm-evidence/
results/
benchmarks/results/

# Python
*.pyc
*.pyo
__pycache__/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment
.env
.env.local
.env.*.local
.secrets.act
data/Road_Traffic_Fine_Management_Process.xes

# Metrics & Logs
*.log
.wasm4pm/build-times.log
.wasm4pm/checkpoint
.wasm4pm/metrics-dashboard.md
.wasm4pm/otel-coverage.json
.wasm4pm/otel-coverage.md
.wasm4pm/production-readiness-phase4-final.json
.wasm4pm/test-wip-system.sh

# Agent hook evidence logs
.claude/evidence/

# Actuation probe outputs (local agent runs; not release artifacts)
artifacts/actuation/raw_evidence/

# Stray CLI output paths
apps/wasm4pm/undefined/
apps/wasm4pm/wasm4pm/target/

# Circular symlink inside wasm4pm/bench_data (points back to repo root bench_data)
wasm4pm/bench_data/bench_data

# Untracked scripts generated during benchmarks
scripts/bench-algorithms.js

# packages/agents: compiled artifacts in src/ (NodeNext shadowing fix — iter13)
# tsconfig.json outDir is ./dist; these .js/.d.ts/.map files were committed before
# that outDir was set and cause NodeNext resolution to pick stale artifacts over
# freshly compiled dist/ output.
packages/agents/src/**/*.js
packages/agents/src/**/*.d.ts
packages/agents/src/**/*.js.map
packages/agents/src/**/*.d.ts.map
/vendors/pm4py
/vendors/POWL

# orphan dir from unset test tmpDir
undefined/

# ggen Ed25519 receipt keys are run-scoped evidence, never repository authority.
# ggen creates both files atomically on the first real sync. The private seed
# remains runner-local; the public key is copied into the BLAKE3 bridge receipt
# so the exact run can be independently reverified without committing a key.
.ggen/keys/signing.key
.ggen/keys/verifying.key

# ggen local sync receipts and CMD observation evidence (not release provenance)
.ggen/receipts/
.ggen/cmd/

# Temporary test artifacts
.gc_test*.txt
run1.json
run2.json
apps/wasm4pm/nul

# Backup files from editor sessions
*.backup

# Scratch run outputs
soar-output*.json

# Generated benchmark reports (regenerate with `bench-tools report|attest`)
docs/benchmarks/REPORT.md
docs/benchmarks/report.csv
docs/benchmarks/ATTESTATION.md

# Accidentally-committed Gemini CLI config symlink (absolute path, escapes repo — breaks cloud/web checkout)
.antigravitycli/

# wasm-pack bundler build output (regenerated by pnpm build) + Rust intermediate libs
crates/wasm4pm-cognition/pkg-bundler/
*.rlib

# LaTeX build byproducts (keep .tex/.pdf tracked)
*.aux
*.toc
PHD_THESIS.out
*.bbl
*.blg

# vitest temp configs
vitest.config.ts.timestamp-*.mjs
nul
