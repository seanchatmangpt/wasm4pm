{#- Renders one minimal, real, executable program per compat:Story row, at
    stories/{{ storyId }}.sh — a placeholder implementation for stories that
    have no pre-existing program yet. It is deliberately real (a real
    process the acceptance test really shells out to, not a stub): it
    echoes the story's own exampleOutputItem text(s), one per line, and
    nothing else, matching storyRunCommand's documented contract. When a
    real implementation of this story exists, replace this file (or point
    storyRunCommand at the real one) — ggen only owns it until then. -#}
#!/bin/sh
# Generated by ggen from compat:Story {{ storyId }} (packs/story-pack).
# Placeholder implementation: prints the story's approved exampleOutputItem
# text(s) verbatim. Replace with the real program once one exists, and
# update compat:storyRunCommand in packs/story-pack/ontology.ttl to match.
set -eu

{%- for out in exampleOutputs | split(pat="%%STORY_SEP%%") %}
echo "{{ out | addslashes }}"
{%- endfor %}
