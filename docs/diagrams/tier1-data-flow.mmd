flowchart LR
    XES["EventLog\nhandle str"] --> Cache{"Columnar\nCache\nFNV-1a hit?"}
    Cache -- miss --> Col["to_columnar_owned\nvocab + trace_offsets\n+ events u32 array"]
    Col --> CacheW["cache_insert\nFNV-1a key\nbounded LRU"]
    Cache -- hit --> BC["ColumnarLog\nborrowed view\nzero-copy"]
    CacheW --> BC
    BC --> Scan["Single-pass scan\n.windows(2)\nfollows FxHashMap\nO(n) time"]
    Scan --> Dep["dep(a,b) =\n|ab| - |ba| / |ab|+|ba|+1\ndependency measure"]
    Dep --> Filter["threshold filter\ndependency >= t\nedges retained"]
    Filter --> DFG["DFG Handle\nnodes + edges\nstored in APP_STATE"]
