{
  "name": "@wasm4pm/engine",
  "version": "26.6.9",
  "publishConfig": {
    "access": "public"
  },
  "description": "Engine lifecycle and state machine for wasm4pm",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@wasm4pm/config": "workspace:*",
    "@wasm4pm/contracts": "workspace:*",
    "@wasm4pm/observability": "workspace:*",
    "blake3": "^2.1.4",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "wasm4pm": "workspace:*",
    "@wasm4pm/testing": "workspace:*",
    "@types/node": "^20.10.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
