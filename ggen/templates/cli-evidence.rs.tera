use anyhow::{bail, Context, Result};
use serde_json::json;
use std::path::{Path, PathBuf};

{% for row in sparql_results %}const SERVICE_NAME: &str = "{{ row.service_name }}";
const RECEIPT_PATH: &str = "{{ row.receipt_path }}";
const SPAN_PATH: &str = "{{ row.span_path }}";
