{
  "name": "wasm4pm-examples",
  "version": "1.0.0",
  "description": "Comprehensive examples guide for wasm4pm process mining",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "npx tsx 01-discovery/01-basic-dfg.ts",
    "discovery": "npx tsx 01-discovery/01-basic-dfg.ts",
    "conformance": "npx tsx 02-conformance/01-basic-fitness.ts",
    "predict": "npx tsx 03-prediction/01-next-activity.ts",
    "autonomic": "npx tsx 04-rl-autonomic/01-health-monitoring.ts",
    "scaling": "npx tsx 06-scaling/01-streaming-dfg.ts",
    "integration": "npx tsx 07-integration/01-cli-workflow.ts",
    "test:examples": "npm run test:examples:build && npm run test:examples:run",
    "test:examples:lint": "eslint **/*.ts --max-warnings 0",
    "test:examples:build": "tsc --noEmit",
    "test:examples:run": "npm run discovery && npm run conformance",
    "validate": "npm run test:examples"
  },
  "keywords": [
    "process-mining",
    "workflow-discovery",
    "conformance-checking",
    "prediction",
    "machine-learning",
    "autonomic-healing",
    "examples",
    "tutorial"
  ],
  "author": "Sean Chatman <xpointsh@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@wasm4pm/cli": "workspace:*",
    "wasm4pm": "workspace:*",
    "@wasm4pm/config": "workspace:*",
    "@wasm4pm/engine": "workspace:*",
    "@wasm4pm/planner": "workspace:*",
    "@wasm4pm/testing": "workspace:*",
    "@wasm4pm/ml": "workspace:*",
    "@wasm4pm/swarm": "workspace:*",
    "@wasm4pm/observability": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.0.0",
    "eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seanchatmangpt/wasm4pm.git",
    "directory": "examples"
  },
  "bugs": {
    "url": "https://github.com/seanchatmangpt/wasm4pm/issues"
  },
  "homepage": "https://github.com/seanchatmangpt/wasm4pm#readme"
}