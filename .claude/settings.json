{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-tool-use.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": ".claude/hooks/cognition-contract-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": ".claude/hooks/cognition-wasm-gate.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
