// Generated by ggen from wasm4pm-compat paper pointers.
// Do not edit: true values and decoys are external authority data.

use serde::de::DeserializeOwned;
use serde_json::{json, Value};
use wasm4pm_cognition::breeds::{dispatch_breed, BreedInput, BreedOutput};

fn fixture_field<T>(input: &Value, key: &str, path: &str) -> T
where
    T: DeserializeOwned + Default,
{
    match input.get(key) {
        None => T::default(),
        Some(value) => serde_json::from_value(value.clone()).unwrap_or_else(|error| {
            panic!("FIXTURE {path} field input.{key} is invalid: {error}")
        }),
    }
}

fn load_fixture(breed_id: &str) -> BreedInput {
    let path = format!(
        "{}/tests/fixtures/papers/{breed_id}.json",
        env!("CARGO_MANIFEST_DIR")
    );
    let raw = std::fs::read_to_string(&path)
        .unwrap_or_else(|error| panic!("MISSING FIXTURE {path}: {error}"));
    let document: Value = serde_json::from_str(&raw)
        .unwrap_or_else(|error| panic!("UNPARSEABLE FIXTURE {path}: {error}"));
    let input = document
        .get("input")
        .unwrap_or_else(|| panic!("FIXTURE {path} has no input object"));

    BreedInput {
        intent: input
            .get("intent")
            .and_then(Value::as_str)
            .unwrap_or_default()
            .to_string(),
        candidates: fixture_field(input, "candidates", &path),
        facts: fixture_field(input, "facts", &path),
        cases: fixture_field(input, "cases", &path),
        rules: fixture_field(input, "rules", &path),
        goals: fixture_field(input, "goals", &path),
        state: fixture_field(input, "state", &path),
    }
}

fn derived_view(input: &BreedInput, output: &BreedOutput) -> Value {
    let derived_facts: Vec<_> = output
        .facts
        .iter()
        .filter(|fact| !input.facts.contains(fact))
        .cloned()
        .collect();

    json!({
        "breed": output.breed,
        "candidates": output.candidates,
        "facts": derived_facts,
        "selected": output.selected,
        "explanation": output.explanation,
        "inference_trace": output.inference_trace,
        "ocel_log": output.ocel_log,
        "retained_cases": output.retained_cases,
    })
}

fn normalized(value: &str) -> String {
    value
        .chars()
        .filter(|character| character.is_alphanumeric())
        .flat_map(char::to_lowercase)
        .collect()
}

fn collect_scalars(value: &Value, strings: &mut Vec<String>, numbers: &mut Vec<f64>) {
    match value {
        Value::String(text) => {
            strings.push(text.clone());
            if let Ok(number) = text.parse::<f64>() {
                numbers.push(number);
            }
        }
        Value::Number(number) => {
            if let Some(number) = number.as_f64() {
                numbers.push(number);
            }
        }
        Value::Bool(boolean) => strings.push(boolean.to_string()),
        Value::Array(values) => {
            for value in values {
                collect_scalars(value, strings, numbers);
            }
        }
        Value::Object(map) => {
            for (key, value) in map {
                strings.push(key.clone());
                collect_scalars(value, strings, numbers);
            }
        }
        Value::Null => {}
    }
}

fn object_contains_pair(value: &Value, key: &str, expected: &str) -> bool {
    match value {
        Value::Object(map) => {
            let encoded = normalized(
                &serde_json::to_string(map).expect("serialize derived output object"),
            );
            let key_matches = encoded.contains(&normalized(key));
            let value_matches = if let Ok(expected_number) = expected.parse::<f64>() {
                let mut strings = Vec::new();
                let mut numbers = Vec::new();
                collect_scalars(value, &mut strings, &mut numbers);
                let tolerance = (expected_number.abs() * 1.0e-6).max(1.0e-6);
                numbers
                    .iter()
                    .any(|actual| (actual - expected_number).abs() <= tolerance)
                    || encoded.contains(&normalized(expected))
            } else {
                encoded.contains(&normalized(expected))
            };
            (key_matches && value_matches)
                || map
                    .values()
                    .any(|child| object_contains_pair(child, key, expected))
        }
        Value::Array(values) => values
            .iter()
            .any(|child| object_contains_pair(child, key, expected)),
        _ => false,
    }
}

fn clause_matches(value: &Value, clause: &str) -> bool {
    let mut strings = Vec::new();
    let mut numbers = Vec::new();
    collect_scalars(value, &mut strings, &mut numbers);

    if let Ok(expected_number) = clause.trim().parse::<f64>() {
        let tolerance = (expected_number.abs() * 1.0e-6).max(1.0e-6);
        return numbers
            .iter()
            .any(|actual| (actual - expected_number).abs() <= tolerance);
    }

    let clause_normalized = normalized(clause);
    if !clause_normalized.is_empty()
        && strings
            .iter()
            .any(|actual| normalized(actual).contains(&clause_normalized))
    {
        return true;
    }

    clause
        .split_once('=')
        .map(|(key, expected)| object_contains_pair(value, key, expected))
        .unwrap_or(false)
}

fn pointer_matches(value: &Value, pointer: &str) -> bool {
    if clause_matches(value, pointer) {
        return true;
    }

    let clauses: Vec<_> = pointer
        .split(',')
        .map(str::trim)
        .filter(|clause| !clause.is_empty())
        .collect();

    clauses.len() > 1 && clauses.iter().all(|clause| clause_matches(value, clause))
}

fn run_derived(breed_id: &str) -> Value {
    let input = load_fixture(breed_id);
    let output = dispatch_breed(breed_id, &input)
        .unwrap_or_else(|error| panic!("{breed_id} real fixture refused: {error}"));
    derived_view(&input, &output)
}

fn assert_true_pointer(breed_id: &str, pointer: &str, locus: &str) {
    let output = run_derived(breed_id);
    assert!(
        pointer_matches(&output, pointer),
        "{breed_id}: derived output did not reproduce paper pointer {pointer:?} ({locus}); output={output}"
    );
}

fn assert_decoy_absent(breed_id: &str, pointer: &str, locus: &str) {
    let output = run_derived(breed_id);
    assert!(
        !pointer_matches(&output, pointer),
        "{breed_id}: derived output matched decoy {pointer:?} ({locus}); output={output}"
    );
}

{% for row in sparql_results %}{% if row.pointer_kind == "true" %}#[test]
fn phd_true_oracle_{{ row.breed_id }}_{{ loop.index }}() {
    assert_true_pointer(
        "{{ row.breed_id }}",
        r#"{{ row.pointer_value }}"#,
        r#"{{ row.pointer_locus }}"#,
    );
}

{% endif %}{% if row.pointer_kind == "decoy" %}#[test]
fn phd_decoy_falsifier_{{ row.breed_id }}_{{ loop.index }}() {
    assert_decoy_absent(
        "{{ row.breed_id }}",
        r#"{{ row.pointer_value }}"#,
        r#"{{ row.pointer_locus }}"#,
    );
}

{% endif %}{% endfor %}