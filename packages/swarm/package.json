{
  "name": "@wasm4pm/swarm",
  "version": "26.6.9",
  "publishConfig": {
    "access": "public"
  },
  "description": "Autonomic swarm coordinator for wasm4pm — multi-worker process mining with convergence detection",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "wasm4pm-swarm": "./dist/mcp-server.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@ai-sdk/groq": "^3.0.35",
    "@modelcontextprotocol/sdk": "^1.10.2",
    "@wasm4pm/contracts": "workspace:*",
    "wasm4pm": "workspace:*",
    "@wasm4pm/observability": "workspace:*",
    "ai": "^6.0.168",
    "smol-toml": "^1.3.4",
    "uuid": "^11.1.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seanchatmangpt/wasm4pm.git",
    "directory": "packages/swarm"
  },
  "homepage": "https://github.com/seanchatmangpt/wasm4pm#readme",
  "bugs": {
    "url": "https://github.com/seanchatmangpt/wasm4pm/issues"
  }
}
