{
  "name": "@wasm4pm/config",
  "version": "26.7.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Configuration management system for wasm4pm with Zod schemas and provenance tracking",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema": {
      "import": "./dist/schema.js",
      "types": "./dist/schema.d.ts"
    },
    "./resolver": {
      "import": "./dist/resolver.js",
      "types": "./dist/resolver.d.ts"
    },
    "./provenance": {
      "import": "./dist/provenance.js",
      "types": "./dist/provenance.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./hash": {
      "import": "./dist/hash.js",
      "types": "./dist/hash.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@wasm4pm/contracts": "workspace:*",
    "blake3": "^2.1.4",
    "toml": "^3.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^1.6.0",
    "pg": "^8.22.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "keywords": [
    "config",
    "configuration",
    "zod",
    "validation",
    "provenance",
    "blake3",
    "hash",
    "wasm4pm"
  ],
  "author": "Sean Chatman",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/seanchatmangpt/wasm4pm.git",
    "directory": "packages/config"
  },
  "homepage": "https://github.com/seanchatmangpt/wasm4pm#readme",
  "bugs": {
    "url": "https://github.com/seanchatmangpt/wasm4pm/issues"
  }
}
