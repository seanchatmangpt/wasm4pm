    schema:target <urn:uuid:invariant-DeterministicSameInputCase> .

wpm:algo_optimized_dfg a mls:Algorithm ;
    rdfs:label "Optimized DFG (ILP)" ;
    rdfs:comment "ILP-based DFG optimization. Minimal model with best fitness." ;
    schema:resultType "dfg" ;
    schema:error <urn:uuid:failure-EmptyLogCase> ;
    schema:error <urn:uuid:failure-MalformedLogCase> ;
    schema:target <urn:uuid:invariant-DeterministicSameInputCase> .

wpm:algo_ilp a mls:Algorithm ;
    rdfs:label "Integer Linear Programming (ILP)" ;
    rdfs:comment "Region-based Petri net discovery. Finds causal place candidates (1-to-1, AND-splits, AND-joins) validated by token replay, with greedy minimization. Produces precise Petri nets with explicit parallel-join/split structure." ;
    schema:resultType "petrinet" ;
    schema:error <urn:uuid:failure-EmptyLogCase> ;
    schema:error <urn:uuid:failure-MalformedLogCase> ;
    schema:target <urn:uuid:invariant-DeterministicSameInputCase> .

wpm:algo_simd_streaming_dfg a mls:Algorithm ;
    rdfs:label "SIMD Streaming DFG" ;
    rdfs:comment "SIMD-accelerated streaming directly-follows graph discovery. Approximately 500x faster than standard DFG via vectorized event processing." ;
    schema:resultType "dfg" ;
    schema:error <urn:uuid:failure-EmptyLogCase> ;
    schema:error <urn:uuid:failure-MalformedLogCase> ;
    schema:target <urn:uuid:invariant-DeterministicSameInputCase> .

wpm:algo_hierarchical_dfg a mls:Algorithm ;
