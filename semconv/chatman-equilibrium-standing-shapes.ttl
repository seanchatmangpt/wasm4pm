@prefix pm: <https://wasm4pm.dev/semconv#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Parsed by src/validate-shacl.mjs. Every property is intentionally separate:
# the parser court ensures repeated sh:property blocks do not alias block 1.
pm:StandingReceiptShape a sh:NodeShape ;
  sh:property [
    sh:path pm:schema ;
    sh:minCount 1 ;
    sh:hasValue "wasm4pm.chatman-equilibrium-standing/1" ;
    sh:message "standing receipt schema must be exact"
  ] ;
  sh:property [
    sh:path pm:exactSubject ;
    sh:minCount 1 ;
    sh:message "exact_subject is required"
  ] ;
  sh:property [
    sh:path pm:subjectBinding ;
    sh:minCount 1 ;
    sh:message "subject_binding is required"
  ] ;
  sh:property [
    sh:path pm:state ;
    sh:minCount 1 ;
    sh:message "standing state is required"
  ] ;
  sh:property [
    sh:path pm:authority ;
    sh:minCount 1 ;
    sh:hasValue "NONE" ;
    sh:message "standing receipt cannot carry authority"
  ] ;
  sh:property [
    sh:path pm:doAuthority ;
    sh:minCount 1 ;
    sh:hasValue false ;
    sh:message "standing receipt cannot grant DO authority"
  ] ;
  sh:property [
    sh:path pm:candidateReceiptSha256 ;
    sh:minCount 1 ;
    sh:message "candidate evidence digest is required"
  ] ;
  sh:property [
    sh:path pm:doctorReportHash ;
    sh:minCount 1 ;
    sh:message "independent verifier digest is required"
  ] ;
  sh:property [
    sh:path pm:replayDigest ;
    sh:minCount 1 ;
    sh:message "replay digest is required"
  ] .
