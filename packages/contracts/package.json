{
  "name": "@wasm4pm/contracts",
  "version": "26.6.10",
  "publishConfig": {
    "access": "public"
  },
  "description": "Runtime contracts, receipts, and hash verification",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./algorithm-registry": {
      "import": "./dist/algorithm-registry.js",
      "require": "./dist/algorithm-registry.js",
      "default": "./dist/algorithm-registry.js",
      "types": "./dist/algorithm-registry.d.ts"
    },
    "./andon-bridge": {
      "import": "./dist/andon-bridge.js",
      "types": "./dist/andon-bridge.d.ts"
    },
    "./atomvm-bridge": {
      "import": "./dist/atomvm-bridge.js",
      "types": "./dist/atomvm-bridge.d.ts"
    },
    "./budget": {
      "import": "./dist/budget.js",
      "types": "./dist/budget.d.ts"
    },
    "./compatibility": {
      "import": "./dist/compatibility.js",
      "types": "./dist/compatibility.d.ts"
    },
    "./conformance-bridge": {
      "import": "./dist/conformance-bridge.js",
      "types": "./dist/conformance-bridge.d.ts"
    },
    "./connectors": {
      "import": "./dist/connectors.js",
      "types": "./dist/connectors.d.ts"
    },
    "./erlang-bridge": {
      "import": "./dist/erlang-bridge.js",
      "types": "./dist/erlang-bridge.d.ts"
    },
    "./errors": {
      "import": "./dist/errors.js",
      "types": "./dist/errors.d.ts"
    },
    "./eventlog": {
      "import": "./dist/eventlog.js",
      "types": "./dist/eventlog.d.ts"
    },
    "./explain": {
      "import": "./dist/explain.js",
      "types": "./dist/explain.d.ts"
    },
    "./prolog8-compiler": {
      "import": "./dist/prolog8-compiler.js",
      "types": "./dist/prolog8-compiler.d.ts"
    },
    "./ocel-bridge": {
      "import": "./dist/ocel-bridge.js",
      "types": "./dist/ocel-bridge.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "blake3": "^2.1.4",
    "uuid": "^11.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "keywords": [
    "contracts",
    "receipts",
    "hashing",
    "blake3",
    "verification"
  ],
  "author": "Sean Chatman",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/seanchatmangpt/wasm4pm.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/seanchatmangpt/wasm4pm#readme",
  "bugs": {
    "url": "https://github.com/seanchatmangpt/wasm4pm/issues"
  }
}
