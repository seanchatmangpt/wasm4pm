\bibitem[Kowalski(1974)]{kowalski1974prolog}
Robert Kowalski.
\newblock Predicate logic as a programming language.
\newblock In \emph{Proceedings of the IFIP Congress 1974}, pages 569--574.
  North-Holland, 1974.
\newblock Introduces logic programming and establishes the procedural
  interpretation of Horn clauses. Co-foundational with Robinson~(1965) for the
  \textsc{prolog} breed.

\bibitem[K{\"u}sters and van~der Aalst(2025)]{kusters2025ocpq}
Aaron K{\"u}sters and Wil M.~P. van~der Aalst.
\newblock {OCPQ}: Object-centric process querying \& constraints.
