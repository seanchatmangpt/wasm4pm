{
  "name": "@wasm4pm/observability",
  "version": "26.6.25",
  "publishConfig": {
    "access": "public"
  },
  "description": "Optional non-blocking OTEL observability layer for wasm4pm",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./file-span-exporter": {
      "import": "./dist/file-span-exporter.js",
      "types": "./dist/file-span-exporter.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^1.0.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.6.0"
  },
  "keywords": [
    "observability",
    "otel",
    "opentelemetry",
    "tracing",
    "process-mining"
  ],
  "author": "Sean Chatman",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/seanchatmangpt/wasm4pm.git",
    "directory": "packages/observability"
  },
  "homepage": "https://github.com/seanchatmangpt/wasm4pm#readme",
  "bugs": {
    "url": "https://github.com/seanchatmangpt/wasm4pm/issues"
  }
}
