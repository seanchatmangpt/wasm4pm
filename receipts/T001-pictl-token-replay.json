    "function": "check_conformance_token_replay",
    "algorithm": "Token replay over DFG model",
    "description": [
      "Iterates each trace in the EventLog",
      "Maintains a token multiset initialised at the start node",
      "For each event: fires matching outgoing edge (consuming+producing token)",
      "If no edge found: records a missing token (log move) and force-places token",
      "After trace: counts remaining tokens not on end-activity nodes (model moves)",
      "fitness = consumed / (consumed + missing) across all traces"
    ]
  },
