@prefix cmd: <https://wasm4pm.dev/cmd#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# G0 is deliberately observation-only. It cannot authorize runtime mutation.
cmd:G0ExactTreeObservation a cmd:Checkpoint ;
  cmd:checkpointId "G0" ;
  cmd:label "Orient and admit the exact repository tree" ;
  cmd:standingCeiling "PARTIAL_ALIVE" ;
  cmd:requiredArtifactsJson "[\"repository.json\",\"surfaces.json\",\"load-paths.json\",\"unknowns.json\"]" ;
  cmd:refusalCodesJson "[\"CMD-G0-EXACT-SET\",\"CMD-G0-BASE-CHANGED\",\"CMD-G0-INDEX-TREE-DIVERGENCE\",\"CMD-G0-RECEIPT-TAMPER\"]" ;
  cmd:allowedMutationScope ".ggen/cmd/**" ;
  cmd:forbiddenMutationScope "production/**" ;
  cmd:forbiddenMutationScope "generated/**" ;
  cmd:requiredCommand "python3 scripts/cmd_g0.py crown --base HEAD" ;
  cmd:requiredFalsifier "tracked-path-omission" ;
  cmd:generatedContract "schemas/cmd-g0-contract.json" .

# Ordered rules form a bounded classification lattice. First matching rule wins.
cmd:G0Rule001 a cmd:PathRule ; cmd:classification "authored constitution" ; cmd:precedence 10 ; cmd:pathPattern "AGENTS.md" .
cmd:G0Rule002 a cmd:PathRule ; cmd:classification "authored constitution" ; cmd:precedence 10 ; cmd:pathPattern "CLAUDE.md" .
cmd:G0Rule003 a cmd:PathRule ; cmd:classification "authored constitution" ; cmd:precedence 10 ; cmd:pathPattern ".claude/rules/*" .
cmd:G0Rule004 a cmd:PathRule ; cmd:classification "workflow" ; cmd:precedence 20 ; cmd:pathPattern ".github/workflows/*" .
cmd:G0Rule005 a cmd:PathRule ; cmd:classification "generated consequence" ; cmd:precedence 30 ; cmd:pathPattern "schemas/cmd-g0-contract.json" .
cmd:G0Rule006 a cmd:PathRule ; cmd:classification "generated consequence" ; cmd:precedence 30 ; cmd:pathPattern "*_generated.rs" .
cmd:G0Rule007 a cmd:PathRule ; cmd:classification "generated consequence" ; cmd:precedence 30 ; cmd:pathPattern "*/generated/*" .
cmd:G0Rule008 a cmd:PathRule ; cmd:classification "generated consequence" ; cmd:precedence 30 ; cmd:pathPattern "wasm4pm/algorithm-registry.json" .
cmd:G0Rule009 a cmd:PathRule ; cmd:classification "generated consequence" ; cmd:precedence 30 ; cmd:pathPattern "crates/wasm4pm-cognition/breeds/registry.json" .
cmd:G0Rule010 a cmd:PathRule ; cmd:classification "template" ; cmd:precedence 40 ; cmd:pathPattern "*.tera" .
cmd:G0Rule011 a cmd:PathRule ; cmd:classification "template" ; cmd:precedence 40 ; cmd:pathPattern "*/templates/*" .
cmd:G0Rule012 a cmd:PathRule ; cmd:classification "fixture" ; cmd:precedence 50 ; cmd:pathPattern "*/fixtures/*" .
cmd:G0Rule013 a cmd:PathRule ; cmd:classification "fixture" ; cmd:precedence 50 ; cmd:pathPattern "*fixture*" .
cmd:G0Rule014 a cmd:PathRule ; cmd:classification "evidence" ; cmd:precedence 60 ; cmd:pathPattern "receipts/*" .
cmd:G0Rule015 a cmd:PathRule ; cmd:classification "evidence" ; cmd:precedence 60 ; cmd:pathPattern "ocel/reports/*" .
cmd:G0Rule016 a cmd:PathRule ; cmd:classification "evidence" ; cmd:precedence 60 ; cmd:pathPattern "docs/benchmarks/*" .
cmd:G0Rule017 a cmd:PathRule ; cmd:classification "domain source" ; cmd:precedence 70 ; cmd:pathPattern "*/ontology/*" .
cmd:G0Rule018 a cmd:PathRule ; cmd:classification "domain source" ; cmd:precedence 70 ; cmd:pathPattern "*.ttl" .
cmd:G0Rule019 a cmd:PathRule ; cmd:classification "domain source" ; cmd:precedence 70 ; cmd:pathPattern "*.rdf" .
cmd:G0Rule020 a cmd:PathRule ; cmd:classification "domain source" ; cmd:precedence 70 ; cmd:pathPattern "*.rq" .
cmd:G0Rule021 a cmd:PathRule ; cmd:classification "configuration" ; cmd:precedence 80 ; cmd:pathPattern "*.toml" .
cmd:G0Rule022 a cmd:PathRule ; cmd:classification "configuration" ; cmd:precedence 80 ; cmd:pathPattern "*.yaml" .
cmd:G0Rule023 a cmd:PathRule ; cmd:classification "configuration" ; cmd:precedence 80 ; cmd:pathPattern "*.yml" .
cmd:G0Rule024 a cmd:PathRule ; cmd:classification "configuration" ; cmd:precedence 80 ; cmd:pathPattern "*.json" .
cmd:G0Rule025 a cmd:PathRule ; cmd:classification "configuration" ; cmd:precedence 80 ; cmd:pathPattern ".gitignore" .
cmd:G0Rule026 a cmd:PathRule ; cmd:classification "implementation" ; cmd:precedence 90 ; cmd:pathPattern "*.rs" .
cmd:G0Rule027 a cmd:PathRule ; cmd:classification "implementation" ; cmd:precedence 90 ; cmd:pathPattern "*.py" .
cmd:G0Rule028 a cmd:PathRule ; cmd:classification "implementation" ; cmd:precedence 90 ; cmd:pathPattern "*.ts" .
cmd:G0Rule029 a cmd:PathRule ; cmd:classification "implementation" ; cmd:precedence 90 ; cmd:pathPattern "*.tsx" .
cmd:G0Rule030 a cmd:PathRule ; cmd:classification "implementation" ; cmd:precedence 90 ; cmd:pathPattern "*.js" .
cmd:G0Rule031 a cmd:PathRule ; cmd:classification "implementation" ; cmd:precedence 90 ; cmd:pathPattern "*.sh" .
cmd:G0Rule032 a cmd:PathRule ; cmd:classification "documentation" ; cmd:precedence 100 ; cmd:pathPattern "docs/*" .
cmd:G0Rule033 a cmd:PathRule ; cmd:classification "documentation" ; cmd:precedence 100 ; cmd:pathPattern "*.md" .
cmd:G0Rule034 a cmd:PathRule ; cmd:classification "archive" ; cmd:precedence 110 ; cmd:pathPattern "archive/*" .
cmd:G0Rule035 a cmd:PathRule ; cmd:classification "archive" ; cmd:precedence 110 ; cmd:pathPattern "archived/*" .
cmd:G0Rule036 a cmd:PathRule ; cmd:classification "asset" ; cmd:precedence 120 ; cmd:pathPattern "*.png" .
cmd:G0Rule037 a cmd:PathRule ; cmd:classification "asset" ; cmd:precedence 120 ; cmd:pathPattern "*.jpg" .
cmd:G0Rule038 a cmd:PathRule ; cmd:classification "asset" ; cmd:precedence 120 ; cmd:pathPattern "*.svg" .
cmd:G0Rule999 a cmd:PathRule ; cmd:classification "unknown" ; cmd:precedence 1000 ; cmd:pathPattern "*" .

# G1-G10 dependency-closed program authority.
cmd:Program a cmd:RefactorProgram ;
  cmd:programId "wasm4pm-combinatorial-maximalism-v1" ;
  cmd:calculus "O→O*→I→G→A→R→O-prime" ;
  cmd:standingCeiling "PARTIAL_ALIVE" ;
  cmd:externalProductionStanding "UNKNOWN" .

cmd:G1 a cmd:Checkpoint ;
  cmd:checkpointId "G1" ;
  cmd:sequence 1 ;
  cmd:objective "Build Chesterton fences and ownership graph" ;
  cmd:standingCeiling "PARTIAL_ALIVE" ;
  cmd:dependsOn cmd:G0 ;
  cmd:requiredArtifact "authority/ownership.json" ;
  cmd:requiredArtifact "authority/fences.json" ;
  cmd:requiredArtifact "authority/collisions.json" ;
  cmd:requiredArtifact "authority/retirement-candidates.json" ;
  cmd:refusalCode "CMD-G1-OWNER-MISSING" ;
  cmd:refusalCode "CMD-G1-DUPLICATE-AUTHORITY" .

cmd:G2 a cmd:Checkpoint ;
  cmd:checkpointId "G2" ;
  cmd:sequence 2 ;
  cmd:objective "Establish canonical semantic authority" ;
  cmd:standingCeiling "PARTIAL_ALIVE" ;
  cmd:dependsOn cmd:G1 ;
  cmd:requiredArtifact "authority/semantic-model.json" ;
  cmd:requiredArtifact "authority/projection-index.json" ;
  cmd:requiredArtifact "authority/roundtrip.json" ;
  cmd:refusalCode "CMD-G2-PROJECTION-DRIFT" ;
  cmd:refusalCode "CMD-G2-REFERENCE-OPEN" ;
  cmd:refusalCode "CMD-G2-STANDING-LIFECYCLE-COLLAPSE" .

cmd:G3 a cmd:Checkpoint ;
  cmd:checkpointId "G3" ;
  cmd:sequence 3 ;
  cmd:objective "Model internal combinatorial maximalism" ;
  cmd:standingCeiling "PARTIAL_ALIVE" ;
  cmd:dependsOn cmd:G2 ;
  cmd:requiredArtifact "candidates/dimensions.json" ;
  cmd:requiredArtifact "candidates/options.json" ;
  cmd:requiredArtifact "candidates/internal-candidates.json" ;
  cmd:requiredArtifact "candidates/coverage.json" ;
  cmd:refusalCode "CMD-G3-DIMENSION-MISSING" ;
  cmd:refusalCode "CMD-G3-DUPLICATE-CANDIDATE" ;
  cmd:refusalCode "CMD-G3-INCOMPATIBLE" ;
  cmd:refusalCode "CMD-G3-COUNT-TAMPER" ;
  cmd:refusalCode "CMD-G3-RESOURCE-OVERFLOW" ;
  cmd:refusalCode "CMD-G3-PREMATURE-AUTHORITY" .

cmd:G4 a cmd:Checkpoint ;
  cmd:checkpointId "G4" ;
  cmd:sequence 4 ;
  cmd:objective "Model external combinatorial maximalism" ;
  cmd:standingCeiling "PARTIAL_ALIVE" ;
  cmd:dependsOn cmd:G3 ;
  cmd:requiredArtifact "candidates/external-candidates.json" ;
  cmd:requiredArtifact "authority/consent.json" ;
  cmd:requiredArtifact "authority/trust.json" ;
  cmd:requiredArtifact "authority/jurisdiction.json" ;
  cmd:requiredArtifact "authority/passports.json" ;
  cmd:refusalCode "CMD-G4-CONSENT-MISSING" ;
  cmd:refusalCode "CMD-G4-CONSENT-SCOPE" ;
  cmd:refusalCode "CMD-G4-JURISDICTION" ;
  cmd:refusalCode "CMD-G4-TRUST-FLOOR" ;
  cmd:refusalCode "CMD-G4-IDENTITY-REVOKED" ;
  cmd:refusalCode "CMD-G4-DIRECT-ACTUATION" ;
  cmd:refusalCode "CMD-G4-POSTCONDITION-MISSING" ;
  cmd:refusalCode "CMD-G4-BROKER-RECEIPT-MISSING" .

cmd:G5 a cmd:Checkpoint ;
  cmd:checkpointId "G5" ;
  cmd:sequence 5 ;
  cmd:objective "Refactor capabilities into atomic packs and Building Blocks" ;
  cmd:standingCeiling "PARTIAL_ALIVE" ;
  cmd:dependsOn cmd:G4 ;
  cmd:requiredArtifact "packs/atomic-packs.json" ;
  cmd:requiredArtifact "packs/bblocks.json" ;
  cmd:requiredArtifact "packs/cmd.lock.json" ;
  cmd:requiredArtifact "packs/compatibility-matrix.json" ;
  cmd:refusalCode "CMD-G5-SEMANTIC-DIVERGENCE" ;
  cmd:refusalCode "CMD-G5-CAPABILITY-OPEN" ;
  cmd:refusalCode "CMD-G5-OUTPUT-OWNER-COLLISION" .

cmd:G6 a cmd:Checkpoint ;
  cmd:checkpointId "G6" ;
  cmd:sequence 6 ;
  cmd:objective "Implement one deterministic IO-free shared kernel" ;
  cmd:standingCeiling "PARTIAL_ALIVE" ;
  cmd:dependsOn cmd:G5 ;
  cmd:requiredArtifact "plans/kernel-plan.json" ;
  cmd:requiredArtifact "verifier/kernel-report.json" ;
  cmd:refusalCode "CMD-G6-CYCLE" ;
  cmd:refusalCode "CMD-G6-OWNERSHIP-COLLISION" ;
  cmd:refusalCode "CMD-G6-UNKNOWN-CAPABILITY" ;
  cmd:refusalCode "CMD-G6-PROFILE-CONFLICT" ;
  cmd:refusalCode "CMD-G6-ACTUATOR-IMPORT" .

cmd:G7 a cmd:Checkpoint ;
  cmd:checkpointId "G7" ;
  cmd:sequence 7 ;
  cmd:objective "Implement transactional local materialization" ;
  cmd:standingCeiling "PARTIAL_ALIVE" ;
  cmd:dependsOn cmd:G6 ;
  cmd:requiredArtifact "plans/materialization-plan.json" ;
  cmd:requiredArtifact "receipts/materializer-intent.json" ;
  cmd:requiredArtifact "receipts/materializer-result.json" ;
  cmd:requiredArtifact "replay/materializer.json" ;
  cmd:refusalCode "CMD-G7-PATH-ESCAPE" ;
  cmd:refusalCode "CMD-G7-SYMLINK-ESCAPE" ;
  cmd:refusalCode "CMD-G7-UNOWNED-WRITE" ;
  cmd:refusalCode "CMD-G7-RESOURCE-OVERFLOW" ;
  cmd:refusalCode "CMD-G7-CHAOS-PARTIAL" .

cmd:G8 a cmd:Checkpoint ;
  cmd:checkpointId "G8" ;
  cmd:sequence 8 ;
  cmd:objective "Implement brokered external actuation" ;
  cmd:standingCeiling "PARTIAL_ALIVE" ;
  cmd:dependsOn cmd:G7 ;
  cmd:requiredArtifact "plans/broker-intent.json" ;
  cmd:requiredArtifact "authority/broker-grant.json" ;
  cmd:requiredArtifact "receipts/broker-intent.json" ;
  cmd:requiredArtifact "receipts/broker-result.json" ;
  cmd:requiredArtifact "replay/broker.json" ;
  cmd:refusalCode "CMD-G8-GRANT-EXPIRED" ;
  cmd:refusalCode "CMD-G8-SUBJECT-MISMATCH" ;
  cmd:refusalCode "CMD-G8-IDEMPOTENCY" ;
  cmd:refusalCode "CMD-G8-RETRY-EXHAUSTED" ;
  cmd:refusalCode "CMD-G8-CIRCUIT-OPEN" ;
  cmd:refusalCode "CMD-G8-ANDON-RED" ;
  cmd:refusalCode "CMD-G8-CONSENT" ;
  cmd:refusalCode "CMD-G8-JURISDICTION" ;
  cmd:refusalCode "CMD-G8-POSTCONDITION" ;
  cmd:refusalCode "CMD-G8-CYCLE-LIMIT" ;
  cmd:refusalCode "CMD-G8-DIRECT-PROVIDER" .

cmd:G9 a cmd:Checkpoint ;
  cmd:checkpointId "G9" ;
  cmd:sequence 9 ;
  cmd:objective "Execute crown verification and self-host the repository" ;
  cmd:standingCeiling "PARTIAL_ALIVE" ;
  cmd:dependsOn cmd:G8 ;
  cmd:requiredArtifact "verifier/report.json" ;
  cmd:requiredArtifact "replay/crown.json" ;
  cmd:requiredArtifact "ocel/crown.json" ;
  cmd:requiredArtifact "gall/crown.json" ;
  cmd:refusalCode "CMD-G9-CANONICAL-TAMPER" ;
  cmd:refusalCode "CMD-G9-GENERATED-TAMPER" ;
  cmd:refusalCode "CMD-G9-CANDIDATE-TAMPER" ;
  cmd:refusalCode "CMD-G9-OWNER-TAMPER" ;
  cmd:refusalCode "CMD-G9-GRANT-TAMPER" ;
  cmd:refusalCode "CMD-G9-RECEIPT-TAMPER" ;
  cmd:refusalCode "CMD-G9-REPLAY-TAMPER" ;
  cmd:refusalCode "CMD-G9-DIRECT-ACTUATION" ;
  cmd:refusalCode "CMD-G9-CONSENT-TAMPER" ;
  cmd:refusalCode "CMD-G9-HEAD-MISMATCH" .

cmd:G10 a cmd:Checkpoint ;
  cmd:checkpointId "G10" ;
  cmd:sequence 10 ;
  cmd:objective "Integrate the dependency-closed combinatorial-maximalism program" ;
  cmd:standingCeiling "PARTIAL_ALIVE" ;
  cmd:dependsOn cmd:G9 ;
  cmd:requiredArtifact "gall/program.json" ;
  cmd:requiredArtifact "gall/work-orders.json" ;
  cmd:requiredArtifact "verifier/aggregate.json" ;
  cmd:requiredArtifact "gall/crown-g10.json" ;
  cmd:refusalCode "CMD-G10-DEPENDENCY-OPEN" ;
  cmd:refusalCode "CMD-G10-STANDING-AVERAGED" ;
  cmd:refusalCode "CMD-G10-RETIREMENT-WITHOUT-EQUIVALENCE" ;
  cmd:refusalCode "CMD-G10-UNRECEIPTED-PROMOTION" .

cmd:G3_runtime a cmd:Dimension ; cmd:checkpoint cmd:G3 ; cmd:dimensionId "runtime" ; cmd:scope "internal" ; cmd:selectionCardinality "exactly-one" ; cmd:riskClass "HIGH" ; cmd:coverageMode "pairwise" ; cmd:resourceCeiling 128 .
cmd:G3_runtime_native_rust a cmd:Option ; cmd:checkpoint cmd:G3 ; cmd:dimension cmd:G3_runtime ; cmd:optionId "native-rust" ; cmd:reversibility "REVERSIBLE" ; cmd:authorityCeiling "PLAN_ONLY" .
cmd:G3_runtime_wasm32 a cmd:Option ; cmd:checkpoint cmd:G3 ; cmd:dimension cmd:G3_runtime ; cmd:optionId "wasm32" ; cmd:reversibility "REVERSIBLE" ; cmd:authorityCeiling "PLAN_ONLY" .
cmd:G3_storage a cmd:Dimension ; cmd:checkpoint cmd:G3 ; cmd:dimensionId "storage" ; cmd:scope "internal" ; cmd:selectionCardinality "exactly-one" ; cmd:riskClass "HIGH" ; cmd:coverageMode "pairwise" ; cmd:resourceCeiling 128 .
