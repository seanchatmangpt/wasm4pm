{
  "name": "@wasm4pm/cognition",
  "version": "26.6.25",
  "private": true,
  "description": "AutoSystems old-AI cognition kernel for wasm4pm: frames, production rules, Prolog, STRIPS, Hearsay-II blackboard, BLAKE3 receipt chain, adversarial gates",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/seanchatmangpt/wasm4pm"
  },
  "main": "pkg/index.js",
  "types": "pkg/index.d.ts",
  "files": [
    "pkg"
  ],
  "scripts": {
    "build": "wasm-pack build --target bundler --out-dir pkg-bundler -- --features wasm",
    "build:nodejs": "wasm-pack build --target nodejs --out-dir pkg -- --features wasm",
    "build:web": "wasm-pack build --target web --out-dir pkg-web -- --features wasm",
    "build:all": "npm run build && npm run build:nodejs && npm run build:web",
    "test": "vitest"
  },
  "devDependencies": {
    "wasm-pack": "^1.3.4"
  }
}
