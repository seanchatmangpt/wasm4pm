    "algorithm": "Greedy alignment over Petri net",
    "description": [
      "Pre-builds input/output arc tables from PetriNet arcs",
      "Initialises marking from place.initial_marking",
      "For each trace event: attempts SyncMove (enabled matching transition) → fires it",
      "If no SyncMove possible: records LogMove (event in log, no enabled transition)",
      "After trace: drains net by firing remaining enabled transitions (ModelMoves)",
      "Prefers invisible transitions during drain phase",
      "fitness = sync_moves / (sync_moves + log_moves + model_moves)"
    ],
    "move_types": ["SyncMove", "LogMove", "ModelMove"]
  },
