cmd:G3_scheduling_synchronous a cmd:Option ; cmd:checkpoint cmd:G3 ; cmd:dimension cmd:G3_scheduling ; cmd:optionId "synchronous" ; cmd:reversibility "REVERSIBLE" ; cmd:authorityCeiling "PLAN_ONLY" .
cmd:G3_scheduling_bounded_parallel a cmd:Option ; cmd:checkpoint cmd:G3 ; cmd:dimension cmd:G3_scheduling ; cmd:optionId "bounded-parallel" ; cmd:reversibility "REVERSIBLE" ; cmd:authorityCeiling "PLAN_ONLY" .
cmd:G3_error_model a cmd:Dimension ; cmd:checkpoint cmd:G3 ; cmd:dimensionId "error-model" ; cmd:scope "internal" ; cmd:selectionCardinality "exactly-one" ; cmd:riskClass "HIGH" ; cmd:coverageMode "exhaustive" ; cmd:resourceCeiling 64 .
cmd:G3_error_model_typed_refusal a cmd:Option ; cmd:checkpoint cmd:G3 ; cmd:dimension cmd:G3_error_model ; cmd:optionId "typed-refusal" ; cmd:reversibility "REVERSIBLE" ; cmd:authorityCeiling "PLAN_ONLY" .
