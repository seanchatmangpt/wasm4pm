{#- Renders one real, executable acceptance test per compat:Story row, at
    stories/{{ storyId }}.test.mjs. This is the fourth combinatorial
    artifact alongside the .feature file, the QA-procedure doc, and the
    ticket -- generated from the SAME compat:Story facts, but unlike the
    other three it does not just describe the story: it really shells out
    to storyRunCommand (a real child process, via node:child_process) and
    asserts the real captured stdout against the story's real
    exampleOutputItem values. No stub, no mock of the program -- if
    storyRunCommand's process is broken, this test fails for real.

    Uses node:test (Node's built-in test runner, zero added dependencies,
    runnable standalone with `node --test`) rather than vitest: this repo's
    installed vitest is a broken/stale pnpm resolution (verified this
    session -- `vitest run` fails with MODULE_NOT_FOUND before this
    template's own code ever runs), so node:test is the honest choice that
    keeps the round trip real and runnable rather than depending on a
    currently-broken test runner. exampleOutputs is "%%STORY_SEP%%"-joined
    by the driving query; split back into the ordered list of expected
    output lines here. -#}
// Generated by ggen from compat:Story {{ storyId }} (packs/story-pack).
// Runs the story's real program (storyRunCommand) as a real child process
// and asserts its real captured stdout against the story's real
// exampleOutputItem values -- not a stub, not a mock.
//
// Run standalone: node --test stories/{{ storyId }}.test.mjs
import { describe, it } from "node:test";
import assert from "node:assert/strict";
import { execSync } from "node:child_process";
import { fileURLToPath } from "node:url";
import path from "node:path";

const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const runCommand = "{{ storyRunCommand | addslashes }}";
const expectedLines = [
{%- for out in exampleOutputs | split(pat="%%STORY_SEP%%") %}
  "{{ out | addslashes }}",
{%- endfor %}
];

describe("{{ storyTitle | addslashes }}", () => {
  it("{{ scenarioName | addslashes }}", () => {
    const stdout = execSync(runCommand, { cwd: repoRoot, encoding: "utf8" });
    const actualLines = stdout.replace(/\n$/, "").split("\n");
    assert.deepEqual(actualLines, expectedLines);
  });
});
