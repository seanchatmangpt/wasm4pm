{
  "schemaVersion": 1,
  "version": "26.4.5",
  "source": {
    "kind": "file"
  },
  "sink": {
    "kind": "stdout"
  },
  "algorithm": {
    "name": "dfg",
    "parameters": {}
  },
  "execution": {
    "profile": "balanced",
    "timeout": 300000
  },
  "observability": {
    "logLevel": "info",
