{
  "@context": {
    "@version": 1.1,
    "wpm": "https://chatmangpt.com/ns/wasm4pm#",
    "pi": "https://chatmangpt.com/ns/wasm4pm/pi#",
    "cognition": "https://chatmangpt.com/ns/wasm4pm/cognition#",
    "trace": "https://chatmangpt.com/ns/wasm4pm/trace#",
    "interview": "https://chatmangpt.com/ns/wasm4pm/interview#",
    "id": "https://chatmangpt.com/id/wasm4pm/",
    "legacyPi": "https://wasm4pm.dev/pi#",
    "legacyCompat": "https://wasm4pm.dev/ns#",
    "prov": "http://www.w3.org/ns/prov#",
    "dcat": "http://www.w3.org/ns/dcat#",
    "dcterms": "http://purl.org/dc/terms/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "schema": "https://schema.org/",
    "mls": "http://www.w3.org/ns/mls#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "Capability": "wpm:Capability",
    "EvidenceArtifact": "wpm:EvidenceArtifact",
    "Receipt": "wpm:Receipt",
    "GallCheckpoint": "wpm:GallCheckpoint",
    "TypedRefusal": "wpm:TypedRefusal",
    "ProcessIntelligenceAlgorithm": "pi:ProcessIntelligenceAlgorithm",
    "CognitionBreed": "cognition:CognitionBreed",
    "TraceRun": "trace:TraceRun",
    "TraceFrame": "trace:TraceFrame",

    "standing": "wpm:standing",
    "sourceRevision": "wpm:sourceRevision",
    "contentDigest": "wpm:contentDigest",
    "positiveWitness": { "@id": "wpm:positiveWitness", "@type": "@id" },
    "negativeFalsifier": { "@id": "wpm:negativeFalsifier", "@type": "@id" },
    "producedReceipt": { "@id": "wpm:producedReceipt", "@type": "@id" },

    "algorithmId": "pi:algorithmId",
    "algorithmLabel": "pi:algorithmLabel",
    "algorithmDoc": "pi:algorithmDoc",
    "citation": "pi:citation",
    "outputType": "pi:outputType",
    "category": "pi:category",
    "speedTier": { "@id": "pi:speedTier", "@type": "xsd:integer" },
    "qualityTier": { "@id": "pi:qualityTier", "@type": "xsd:integer" },
    "wasmExport": "pi:wasmExport",
    "cliAlias": "pi:cliAlias",
    "inputFormat": "pi:inputFormat",
    "measuredFitness": { "@id": "pi:measuredFitness", "@type": "xsd:decimal" },
    "piAdmitted": { "@id": "pi:piAdmitted", "@type": "xsd:boolean" },

    "breedId": "cognition:breedId",
    "breedLabel": "cognition:breedLabel",
    "breedDoc": "cognition:breedDoc",
    "modulePath": "cognition:modulePath",
    "breedStatus": "cognition:breedStatus",
    "ocelAdmitted": { "@id": "cognition:ocelAdmitted", "@type": "xsd:boolean" }
  }
}
